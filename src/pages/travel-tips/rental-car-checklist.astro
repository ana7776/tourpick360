---
import SourceBadge from '../../components/SourceBadge.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const totalCostRows = [
  ['대여 요금', '비교 사이트에 가장 크게 표시되는 금액입니다.', '같은 차종이라도 인수 지점과 시간대에 따라 달라집니다.'],
  ['자차 보험료', '요금과 별도로 하루 단위로 붙습니다.', '보상 한도와 면책금이 다르면 같은 이름이라도 다른 상품입니다.'],
  ['유류비 또는 충전비', '반납 조건에 따라 정산 방식이 달라집니다.', '만차 반납인지 사용량 정산인지 예약 화면에서 확인합니다.'],
  ['주차비', '숙소와 관광지에서 따로 발생합니다.', '숙소 무료 주차가 안 되면 1박마다 추가됩니다.'],
  ['편도 반납료', '인수 지점과 반납 지점이 다를 때 붙습니다.', '공항 인수 후 시내 반납 일정에서 자주 놓칩니다.'],
  ['시간 초과 요금', '반납이 늦어지면 시간 단위로 가산됩니다.', '항공편 지연보다 반납장 대기 때문에 생기는 경우가 많습니다.']
];

const checkRows = [
  ['1. 인수 장소', '공항 청사에서 걸어가는지, 셔틀을 타야 하는지 확인합니다.', '도착 직후 30~40분이 이동과 대기로 사라집니다.'],
  ['2. 셔틀 운행', '배차 간격과 첫차·막차 시간을 봅니다.', '늦은 도착 항공편이면 인수 자체가 불가능할 수 있습니다.'],
  ['3. 보험 조건', '보상 한도, 면책금(자기부담금), 휴차 보상료 면제 여부를 확인합니다.', '사고 때 수리비보다 휴차 보상료에서 분쟁이 생깁니다.'],
  ['4. 운전자 추가', '추가 등록 인원, 비용, 필요 서류를 확인합니다.', '등록하지 않은 사람이 운전하면 보험 적용이 어려워집니다.'],
  ['5. 반납 시간', '항공편 출발 시간에서 거꾸로 계산합니다.', '탑승 수속 시간이 부족해 일정 전체가 무너집니다.'],
  ['6. 숙소 주차', '무료 주차 여부, 주차장 진입로, 만차 시 대안을 확인합니다.', '골목 숙소는 도착 후 주차 자리를 찾느라 시간이 듭니다.'],
  ['7. 카시트', '대여 가능 여부, 연령 기준, 장착 방식을 확인합니다.', '현장에서 장착이 안 되면 출발 자체가 지연됩니다.'],
  ['8. 전기차 여부', '숙소와 동선 주변 충전 환경을 먼저 봅니다.', '충전 대기 시간이 관광 시간을 잡아먹습니다.'],
  ['9. 운전 난이도', '야간, 우천, 강풍, 산길 구간이 있는지 확인합니다.', '운전자 피로가 다음 날 일정까지 밀어냅니다.'],
  ['10. 취소 규정', '무료 취소 기한과 성수기 변경 수수료를 확인합니다.', '일정이 바뀌면 취소가 아니라 위약금 문제가 됩니다.']
];

const insuranceRows = [
  ['미가입', '가장 저렴합니다.', '사고 시 수리비 전액과 휴차 보상료를 부담할 수 있습니다.'],
  ['일반 자차', '요금 부담이 크지 않습니다.', '면책금이 남고 보상 한도를 넘는 금액은 본인 부담입니다.'],
  ['완전 자차', '면책금과 휴차 보상료까지 면제되는 경우가 많습니다.', '상품마다 면제 범위가 달라 이름만 보고 판단하면 안 됩니다.']
];

const returnRows = [
  ['항공편 출발', '기준 시각', '여기서부터 거꾸로 계산합니다.'],
  ['탑승 수속과 보안 검색', '출발 60~90분 전 도착', '성수기와 연휴에는 더 앞당기는 편이 안전합니다.'],
  ['셔틀 이동과 대기', '15~30분', '반납장이 공항 밖이면 배차 간격까지 더해야 합니다.'],
  ['반납 점검과 정산', '10~20분', '차량 확인과 결제, 영수증 처리 시간입니다.'],
  ['주유 또는 충전', '15~30분', '반납장 근처 주유소는 반납 시간대에 줄이 생깁니다.'],
  ['숙소에서 출발', '위 시간을 모두 더한 시각', '이 시각이 마지막 관광 일정의 종료 시각이 됩니다.']
];

const sizeRows = [
  ['2인, 캐리어 2개', '경차·소형', '주차와 골목 진입이 쉽고 유류비 부담이 적습니다.'],
  ['3~4인, 캐리어 3개', '준중형·중형', '짐칸이 부족하면 뒷좌석에 짐을 올려야 합니다.'],
  ['부모님 동반 4인', '중형 이상', '승하차 높이와 뒷좌석 공간이 만족도를 좌우합니다.'],
  ['5인 이상 또는 유아 동반', 'SUV·미니밴', '카시트 장착 후 남는 짐 공간을 기준으로 봅니다.']
];

const breadcrumbItems = [
  { name: '여행 준비', href: '/travel-tips/' },
  { name: '렌터카 예약 전 확인해야 할 10가지', href: '/travel-tips/rental-car-checklist/' }
];
---
<BaseLayout title="렌터카 예약 전 확인해야 할 10가지 - Tourpick360" description="제주와 국내 여행 렌터카 예약 전 보험 면책금, 인수 위치, 반납 시간 역산, 숙소 주차 동선을 총비용 기준으로 확인하는 체크리스트입니다.">
  <article class="article-page longform">
    <Breadcrumb items={breadcrumbItems} />
    <p class="eyebrow">렌터카 예약</p>
    <h1>렌터카 예약 전 확인해야 할 10가지</h1>
    <SourceBadge />
    <p class="lead">렌터카는 하루 요금만 보고 고르면 실제 여행 중 시간이 더 많이 낭비될 수 있습니다. 결제 화면의 금액은 총비용의 일부이고, 여행 만족도를 흔드는 것은 대부분 인수 위치, 반납 시각, 숙소 주차처럼 요금표에 적히지 않는 조건입니다. 아래 10가지는 예약 버튼을 누르기 전에 한 번에 확인할 수 있도록 정리한 항목입니다.</p>
    <figure class="article-hero-image">
      <img src="/images/tourapi/jeju_aewol.jpg" alt="렌터카 여행 점검표 참고 이미지" width="1200" height="675" loading="eager" />
      <figcaption>렌터카 일정에는 인수와 반납 시간, 주차, 보험, 주유, 날씨 대비까지 함께 넣어야 합니다.</figcaption>
    </figure>

    <h2>핵심 요약</h2>
    <table>
      <tbody>
        <tr><th>추천 대상</th><td>제주 여행 첫 렌터카 이용자, 아이나 부모님과 함께 이동하는 가족, 항공편 시간이 빠듯한 주말 여행자</td></tr>
        <tr><th>확인 순서</th><td>총비용 계산 → 보험 조건 → 인수·반납 시각 → 숙소 주차 → 취소 규정</td></tr>
        <tr><th>가장 자주 놓치는 항목</th><td>셔틀 이동 시간, 면책금, 숙소 주차 가능 여부, 반납일 마지막 일정</td></tr>
        <tr><th>주의사항</th><td>요금과 약관은 업체·플랫폼·날짜에 따라 달라지므로 결제 전 상세 약관을 다시 확인해야 합니다.</td></tr>
      </tbody>
    </table>

    <h2>요금이 아니라 총비용으로 비교합니다</h2>
    <p>렌터카 비교에서 가장 흔한 실수는 하루 대여 요금만으로 순위를 매기는 것입니다. 같은 차종이라도 아래 항목이 어디에 얼마나 붙는지에 따라 최종 지출이 달라지고, 특히 편도 반납료와 주차비는 예약 화면에서 보이지 않다가 여행 중에 나타납니다.</p>
    <table>
      <thead>
        <tr><th>항목</th><th>어디에 붙는가</th><th>확인할 점</th></tr>
      </thead>
      <tbody>
        {totalCostRows.map(([item, where, check]) => (
          <tr><td><strong>{item}</strong></td><td>{where}</td><td>{check}</td></tr>
        ))}
      </tbody>
    </table>
    <p>비교표를 만들 때는 업체별로 <strong>대여 요금 + 보험료 + 예상 유류비 + 1박당 주차비</strong>를 한 칸에 합쳐 적어두면 순위가 뒤바뀌는 경우가 많습니다. 요금이 가장 싼 업체가 셔틀 이동 20분과 유료 주차를 요구한다면, 조금 비싸도 청사에서 바로 인수하는 쪽이 실제로는 유리합니다.</p>

    <h2>예약 전 확인 항목 10가지</h2>
    <table>
      <thead>
        <tr><th>항목</th><th>확인 방법</th><th>놓치면 생기는 일</th></tr>
      </thead>
      <tbody>
        {checkRows.map(([item, how, risk]) => (
          <tr><td><strong>{item}</strong></td><td>{how}</td><td>{risk}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>보험은 이름이 아니라 면책금과 휴차 보상료로 봅니다</h2>
    <p>자차 보험 상품은 업체마다 이름이 다르고, 같은 이름이라도 면제 범위가 다릅니다. 판단 기준은 상품명이 아니라 두 가지입니다. 사고가 났을 때 내가 먼저 부담해야 하는 금액인 <strong>면책금(자기부담금)</strong>이 얼마인지, 그리고 수리 기간 동안 업체가 차를 빌려주지 못해 발생하는 <strong>휴차 보상료</strong>가 면제되는지입니다. 실제 분쟁은 수리비보다 이 두 항목에서 생깁니다.</p>
    <table>
      <thead>
        <tr><th>가입 유형</th><th>장점</th><th>남는 위험</th></tr>
      </thead>
      <tbody>
        {insuranceRows.map(([type, pro, risk]) => (
          <tr><td><strong>{type}</strong></td><td>{pro}</td><td>{risk}</td></tr>
        ))}
      </tbody>
    </table>
    <p>초보 운전자, 낯선 지역에서의 야간 운전, 좁은 골목 숙소 주차가 예정된 일정이라면 보험료를 아끼는 것보다 면책금을 없애는 쪽이 마음 편합니다. 반대로 운전 경험이 많고 이동 거리가 짧은 일정이라면 일반 자차로 충분한 경우도 있습니다. 어느 쪽이든 예약 화면의 보상 한도 숫자를 직접 읽고 결정해야 합니다.</p>

    <h2>반납 시간은 마지막 일정이 아니라 역산으로 정합니다</h2>
    <p>여행 마지막 날이 무너지는 이유는 대부분 반납 시각을 대충 잡았기 때문입니다. 반납은 하나의 작업이 아니라 주유, 이동, 점검, 정산, 셔틀 대기가 이어진 묶음입니다. 항공편 출발 시각에서 거꾸로 계산해 두면 마지막 관광지를 어디까지 넣을 수 있는지가 자동으로 정해집니다.</p>
    <table>
      <thead>
        <tr><th>단계</th><th>필요한 시간</th><th>메모</th></tr>
      </thead>
      <tbody>
        {returnRows.map(([step, time, memo]) => (
          <tr><td><strong>{step}</strong></td><td>{time}</td><td>{memo}</td></tr>
        ))}
      </tbody>
    </table>
    <p>표의 시간은 여유 있는 기준이며 공항과 업체, 시간대에 따라 달라집니다. 성수기 주말과 비 오는 날에는 반납장 진입과 셔틀 대기가 특히 길어지므로 30분을 더 확보하는 편이 안전합니다.</p>

    <h2>인원과 짐으로 차량 크기를 정합니다</h2>
    <p>차량 등급은 승차 인원이 아니라 짐을 기준으로 정하는 편이 실패가 적습니다. 정원 5인 차량에 성인 5명과 캐리어 4개를 넣으면 자리는 있어도 짐이 남습니다. 유아 동반이라면 카시트가 좌석 하나를 차지한다는 점까지 계산해야 합니다.</p>
    <table>
      <thead>
        <tr><th>동행 구성</th><th>무난한 등급</th><th>판단 기준</th></tr>
      </thead>
      <tbody>
        {sizeRows.map(([group, grade, basis]) => (
          <tr><td><strong>{group}</strong></td><td>{grade}</td><td>{basis}</td></tr>
        ))}
      </tbody>
    </table>
    <p>도로교통법상 6세 미만 아동은 유아보호용 장구를 사용해야 하므로, 아이와 함께 여행한다면 카시트는 선택이 아니라 필수 항목으로 넣고 대여 가능 여부를 예약 단계에서 확인해야 합니다.</p>

    <h2>제주 여행에서 특히 중요한 기준</h2>
    <p>제주는 관광지가 넓게 퍼져 있어 차량 이동이 편하지만, 모든 일정에 렌터카가 유리한 것은 아닙니다. 공항 근처 1박, 중문 리조트 휴식형 일정, 성산 일출 일정처럼 숙소 위치가 뚜렷하면 렌터카 인수일과 반납일을 나누는 편이 더 효율적일 수 있습니다. 도착 첫날은 공항 주변에서 대중교통이나 택시로 움직이고 다음 날 아침에 차를 받으면 하루치 요금과 주차비를 아끼면서 도착 직후의 피로도 줄일 수 있습니다.</p>
    <p>아이와 함께 이동하거나 부모님을 모시는 여행이라면 차량 등급보다 승하차 편의, 짐 적재 공간, 숙소 주차 동선을 우선해서 보는 것이 좋습니다. 해안도로 구간은 풍속이 강한 날이 있고, 중산간 도로는 안개와 야간 조명 부족을 함께 고려해야 합니다.</p>

    <h2>렌터카가 오히려 불리한 일정</h2>
    <p>차가 항상 정답은 아닙니다. 아래에 해당한다면 대중교통과 택시를 섞는 쪽이 시간과 비용 모두에서 나은 경우가 많습니다.</p>
    <ul>
      <li>구도심 골목이나 시장 주변에 숙소를 잡아 주차 자리를 찾기 어려운 일정</li>
      <li>축제 기간처럼 행사장 주변 도로가 통제되고 임시 주차장이 멀어지는 일정</li>
      <li>저녁에 술자리가 포함되어 운전자가 사실상 하루를 묶여 있어야 하는 일정</li>
      <li>KTX 역 주변에서 도보로 대부분을 해결할 수 있는 1박 2일 단거리 일정</li>
      <li>운전자가 한 명뿐인데 하루 이동 거리가 200km를 넘는 일정</li>
    </ul>

    <section class="checklist-box">
      <h2>결제 직전 최종 체크리스트</h2>
      <ul>
        <li>대여 요금에 보험료, 유류비, 주차비, 편도 반납료를 더한 총비용을 계산했는지 확인하기</li>
        <li>면책금 금액과 휴차 보상료 면제 여부를 약관에서 직접 확인하기</li>
        <li>항공편 출발 시각에서 역산한 반납 시각을 일정표에 적어두기</li>
        <li>운전할 사람 전원을 추가 운전자로 등록했는지 확인하기</li>
        <li>숙소 무료 주차 가능 여부와 만차 시 대안 주차장 확인하기</li>
        <li>무료 취소 기한을 캘린더에 알림으로 등록하기</li>
      </ul>
    </section>

    <section>
      <h2>자주 묻는 질문</h2>
      <div class="faq-list">
        <details>
          <summary>완전 자차 보험은 꼭 들어야 하나요?</summary>
          <p>의무는 아닙니다. 다만 초보 운전, 야간·우천 운전, 좁은 주차 환경이 겹치는 일정이라면 면책금과 휴차 보상료가 면제되는 쪽이 분쟁 위험이 작습니다. 상품명이 아니라 면제 범위를 읽고 판단하세요.</p>
        </details>
        <details>
          <summary>공항 인수와 시내 인수 중 어느 쪽이 나은가요?</summary>
          <p>도착 직후 바로 이동해야 하면 공항 인수가 편하고, 첫날 숙소 주변만 다닐 계획이면 다음 날 시내 인수가 요금과 주차비 면에서 유리할 수 있습니다. 셔틀 이동 시간까지 넣어 비교하세요.</p>
        </details>
        <details>
          <summary>반납은 항공편 몇 시간 전으로 잡아야 하나요?</summary>
          <p>주유, 반납 점검, 셔틀 이동, 탑승 수속을 모두 더해 역산해야 합니다. 성수기나 비 오는 날에는 여기에 30분을 더 확보하는 편이 안전합니다.</p>
        </details>
        <details>
          <summary>전기차 렌터카는 어떤 기준으로 판단하나요?</summary>
          <p>요금보다 충전 환경이 기준입니다. 숙소에 충전기가 있는지, 하루 이동 거리가 한 번 충전으로 가능한지, 충전 대기 시간을 일정에 넣어도 괜찮은지를 먼저 확인하세요.</p>
        </details>
      </div>
    </section>

