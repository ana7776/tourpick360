---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProblemSolvingArticle from '../../../components/ProblemSolvingArticle.astro';
import { problemSolvingArticles, allProblemSolvingArticles } from '../../../data/problemSolvingArticles.js';
import { buildSearchDescription, buildSearchTitle } from '../../../utils/searchSnippets.js';

export function getStaticPaths() {
  return problemSolvingArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const related = allProblemSolvingArticles.filter((item) => item.title !== article.title).slice(0, 4);
const seoTitle = buildSearchTitle(article, '해결 기준·체크리스트');
const seoDescription = buildSearchDescription(article);
---
<BaseLayout title={seoTitle} description={seoDescription}>
  <ProblemSolvingArticle article={article} related={related} />
</BaseLayout>
