---
import BaseLayout from '../layouts/BaseLayout.astro';

const categoryCards = [
  {
    title: '숙소 추천',
    summary: '지역별 숙소 권역과 실제 이동 후기',
    icon: '숙',
    href: '/travel-tips/hotel-booking-checklist/'
  },
  {
    title: '국내 축제',
    summary: '시기별 축제 일정과 즐길 거리 안내',
    icon: '축',
    href: '/domestic/festivals/'
  },
  {
    title: '제주 여행',
    summary: '제주 숙소, 코스, 실용 정보 정리',
    icon: '제',
    href: '/domestic/jeju/'
  },
  {
    title: '맛집 지도',
    summary: '식사 대기와 동선을 함께 보는 코스',
    icon: '맛',
    href: '/domestic/festivals/autumn-food-festival-route/'
  },
  {
    title: '교통 정보',
    summary: 'KTX, 버스, 렌터카 이동 팁',
    icon: '교',
    href: '/travel-tips/rental-car-checklist/'
  },
  {
    title: '여행 체크리스트',
    summary: '출발 전 확인할 준비 포인트',
    icon: '준',
    href: '/travel-tips/'
  }
];

const latestGuides = [
  {
    category: '거제 여행지',
    title: '거제 여행지 권역별 추천 코스와 동선 가이드',
    summary: '외도 보타니아, 바람의언덕, 해금강, 매미성, 거제식물원을 권역별로 나눴습니다.',
    date: '2026.07.06',
    image: '/images/tourapi/geoje-wind-hill.jpg',
    alt: '거제 바람의언덕 바다 전망',
    href: '/domestic/geoje/attraction-area-guide/'
  },
  {
    category: '모임 후기',
    title: '칠갑산 천장호와 부여 궁남지 연꽃축제 당일 코스',
    summary: '10명 모임의 실제 정산, 점심 웨이팅, 궁남지와 국립부여박물관 후기를 담았습니다.',
    date: '2026.07.06',
    image: '/images/buyeo-lotus-chilgapsan/gungnamji-lotus-pond-wide.webp',
    alt: '부여 궁남지 연꽃축제 연꽃 풍경',
    href: '/domestic/festivals/buyeo-lotus-chilgapsan-group-trip-review/'
  },
  {
    category: '강릉 여행지',
    title: '강릉 여행지 권역별 추천 코스와 이동 기준',
    summary: '경포, 안목, 주문진, 오죽헌 권역을 날씨와 교통 기준으로 다시 묶었습니다.',
    date: '2026.07.06',
    image: '/images/home/geoje-coast-hero.webp',
    alt: '강릉 안목해변 풍경',
    href: '/domestic/gangneung/attraction-area-guide/'
  },
  {
    category: '가족 여행',
    title: '아이와 함께 가기 좋은 여행지 선택 기준',
    summary: '체력, 식사, 낮잠, 이동 시간을 기준으로 가족 여행 동선을 줄입니다.',
    date: '2026.07.05',
    image: '/images/tourapi/family_trip.jpg',
    alt: '가족 여행 야외 풍경',
    href: '/travel-tips/child-travel-fatigue-solution/'
  },
  {
    category: '날씨별 여행',
    title: '비 오는 날 가볼 만한 곳을 고르는 법',
    summary: '실내 코스와 숙소 권역을 함께 묶어 이동 손실을 줄이는 기준입니다.',
    date: '2026.07.04',
    image: '/images/tourapi/museum.jpg',
    alt: '비 오는 날 실내 여행지 이미지',
    href: '/travel-tips/rainy-day-backup-plan/'
  }
];

const destinations = [
  ['강릉', '바다와 카페 동선', '/images/domestic-places/gangneung-anmok-beach.jpg', '/domestic/gangneung/attraction-area-guide/'],
  ['거제', '섬 정원과 남해 전망', '/images/tourapi/geoje-wind-hill.jpg', '/domestic/geoje/attraction-area-guide/'],
  ['부여', '연꽃축제와 백제 여행', '/images/buyeo-lotus-chilgapsan/gungnamji-lotus-pond-wide.webp', '/domestic/festivals/buyeo-lotus-chilgapsan-group-trip-review/'],
  ['부산', '가족 숙소와 해변', '/images/domestic-places/busan-haeundae-beach.jpg', '/domestic/busan/family-hotel-area-guide/'],
  ['제주', '숙소 권역과 렌터카', '/images/tourapi/jeju_yongduam.jpg', '/domestic/jeju/'],
  ['경주', '도보 여행과 숙소 위치', '/images/domestic-places/gyeongju-daereungwon.jpg', '/domestic/gyeongju/walking-route-hotel-area-guide/']
];

const prepLinks = [
  ['비 오는 날 어디 가지?', '날씨별 여행', '날', '/travel-tips/rainy-day-backup-plan/'],
  ['가족여행 코스 추천', '동행자별 일정', '가', '/travel-tips/child-travel-fatigue-solution/'],
  ['KTX 여행 가이드', '도착역 기준 동선', 'K', '/domestic/gangneung/ktx-weekend-trip-guide/'],
  ['제주 렌터카 이용 팁', '인수·반납 체크', '렌', '/travel-tips/rental-car-checklist/'],
  ['숙소 예약 체크리스트', '취소·짐보관 확인', '숙', '/travel-tips/hotel-booking-checklist/'],
  ['당일치기 추천 코스', '짧은 일정 설계', '일', '/travel-tips/itinerary-before-after/']
];

const trustItems = [
  ['사이트 소개', '국내 여행 정보를 한곳에서 비교하고 계획할 수 있도록 정리합니다.', '소', '/about/'],
  ['운영 원칙', '과장보다 실제 일정에 필요한 기준과 확인 가능한 정보를 우선합니다.', '원', '/editorial-policy/'],
  ['콘텐츠 기준', '공식 출처, 현장 변수, 이동 동선, 비용 기준을 함께 확인합니다.', '기', '/editorial-policy/'],
  ['문의하기', '수정 제안이나 제보할 내용이 있으면 언제든지 문의할 수 있습니다.', '문', '/contact/'],
  ['개인정보처리방침', '개인정보 보호와 이용 환경 기준을 명확하게 안내합니다.', '개', '/privacy/']
];

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Tourpick360',
  url: 'https://tourpick360.com',
  description: '국내 여행, 축제, 숙소 위치, 이동 동선을 함께 정리하는 여행 정보 사이트',
  inLanguage: 'ko-KR'
};
---
<BaseLayout
  title="TourPick360 - 국내 여행 가이드와 여행 준비 정보"
  description="TourPick360은 국내 여행지, 축제, 제주 여행, 숙소 권역, 맛집 동선, 교통 정보와 여행 준비 체크리스트를 한곳에서 정리하는 여행 가이드입니다."
  image="/images/home/geoje-coast-hero.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

  <section class="sky-home-hero" aria-label="TourPick360 여행 검색">
    <div class="sky-hero-inner">
      <div class="sky-hero-copy">
        <h1>더 스마트한 여행 계획,<br />더 특별한 여행 경험</h1>
        <p>국내 여행 정보를 한 곳에서. 믿을 수 있는 기준으로 숙소, 동선, 날씨, 축제 일정을 함께 준비하세요.</p>
        <form class="sky-search" action="/search/" method="get">
          <label class="sr-only" for="sky-search-input">여행 정보 검색</label>
          <input id="sky-search-input" name="q" type="search" placeholder="어디로 떠나시나요? (지역, 명소, 축제 검색)" />
          <button type="submit">검색</button>
        </form>
        <div class="sky-hero-actions">
          <a class="primary" href="/domestic/">여행지 둘러보기</a>
          <a href="/travel-tips/">오늘의 여행 추천</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sky-category-strip" aria-label="주요 서비스">
    {categoryCards.map((card) => (
      <a href={card.href}>
        <span>{card.icon}</span>
        <strong>{card.title}</strong>
        <small>{card.summary}</small>
      </a>
    ))}
  </section>

  <section class="sky-content-section">
    <div class="sky-title-row">
      <h2>최신 여행 가이드</h2>
      <a href="/domestic/">더보기</a>
    </div>
    <div class="sky-guide-grid">
      {latestGuides.map((guide) => (
        <a href={guide.href}>
          <img src={guide.image} alt={guide.alt} width="420" height="240" loading="lazy" />
          <div>
            <span>{guide.category}</span>
            <strong>{guide.title}</strong>
            <p>{guide.summary}</p>
            <small>{guide.date}</small>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="sky-content-section sky-two-column">
    <div class="sky-destination-panel">
      <div class="sky-title-row">
        <h2>인기 여행지</h2>
      </div>
      <div class="sky-destination-grid">
        {destinations.map(([name, summary, image, href]) => (
          <a href={href}>
            <img src={image} alt={`${name} 여행지 풍경`} width="220" height="150" loading="lazy" />
            <strong>{name}</strong>
            <small>{summary}</small>
          </a>
        ))}
      </div>
    </div>

    <div class="sky-prep-panel">
      <div class="sky-title-row">
        <h2>여행 준비가 막막하신가요?</h2>
        <a href="/travel-tips/">더보기</a>
      </div>
      <div class="sky-prep-grid">
        {prepLinks.map(([title, summary, icon, href]) => (
          <a href={href}>
            <span>{icon}</span>
            <strong>{title}</strong>
            <small>{summary}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sky-trust-strip" aria-label="사이트 운영 정보">
    {trustItems.map(([title, summary, icon, href]) => (
      <a href={href}>
        <span>{icon}</span>
        <strong>{title}</strong>
        <small>{summary}</small>
      </a>
    ))}
  </section>
</BaseLayout>
