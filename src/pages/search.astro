---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="검색 - Tourpick360"
  description="Tourpick360에서 지역 명소, 축제, 숙소 권역 관련 여행 정보를 검색합니다."
  robots="noindex, follow"
>
  <section class="search-page">
    <div class="search-head">
      <p class="eyebrow">Search</p>
      <h1>여행 정보 검색</h1>
      <p class="search-lead">
        지역명이나 축제명, 숙소 권역, 여행 상황을 입력하면 관련 페이지를 찾아 보여줍니다.
      </p>

      <form class="search-form" id="search-form" role="search">
        <label class="sr-only" for="search-input">검색어</label>
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="예: 무주, 덕진공원, 제주 숙소, 비 오는 날"
          autocomplete="off"
        />
        <button type="submit">검색</button>
      </form>

      <div class="search-suggest" aria-label="추천 검색어">
        <span>추천 검색어</span>
        <button type="button" data-term="제주 숙소">제주 숙소</button>
        <button type="button" data-term="축제">축제</button>
        <button type="button" data-term="전주">전주</button>
        <button type="button" data-term="무주">무주</button>
        <button type="button" data-term="비 오는 날">비 오는 날</button>
        <button type="button" data-term="렌터카">렌터카</button>
      </div>
    </div>

    <div class="search-status" id="search-status" role="status" aria-live="polite"></div>
    <ol class="search-results" id="search-results"></ol>
  </section>
</BaseLayout>

<style>
  .search-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 56px 24px 80px;
  }

  .search-head h1 {
    margin: 6px 0 10px;
    font-size: 34px;
    line-height: 1.25;
  }

  .search-lead {
    margin: 0 0 24px;
    color: var(--muted);
  }

  .search-form {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
  }

  .search-form input {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 16px;
    background: #fff;
  }

  .search-form button {
    padding: 14px 22px;
    border: 0;
    border-radius: 10px;
    background: var(--rail);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .search-suggest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
  }

  .search-suggest span {
    font-size: 13px;
    color: var(--muted);
    margin-right: 2px;
  }

  .search-suggest button {
    padding: 7px 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font-size: 13px;
    color: inherit;
    cursor: pointer;
  }

  .search-suggest button:hover,
  .search-suggest button:focus-visible {
    border-color: var(--rail);
  }

  .search-status {
    margin-bottom: 18px;
    font-size: 14px;
    color: var(--muted);
    min-height: 20px;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .search-results li {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
  }

  .search-results a {
    display: block;
    padding: 18px 20px;
    text-decoration: none;
    color: inherit;
  }

  .search-results a:hover,
  .search-results a:focus-visible {
    border-radius: 12px;
    outline-color: var(--rail);
  }

  .search-results h2 {
    margin: 0 0 6px;
    font-size: 18px;
    line-height: 1.4;
  }

  .search-results p {
    margin: 0 0 8px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  .search-results small {
    font-size: 12px;
    color: var(--muted);
  }

  .search-results mark {
    background: #fdf1c4;
    padding: 0 2px;
  }

  @media (max-width: 640px) {
    .search-page {
      padding: 40px 18px 64px;
    }

    .search-head h1 {
      font-size: 27px;
    }

    .search-form {
      flex-direction: column;
    }
  }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('search-form');
    var input = document.getElementById('search-input');
    var status = document.getElementById('search-status');
    var list = document.getElementById('search-results');
    var indexData = null;
    var loading = null;

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function escapeRegExp(value) {
      return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function loadIndex() {
      if (indexData) return Promise.resolve(indexData);
      if (loading) return loading;
      loading = fetch('/search-index.json')
        .then(function (res) {
          if (!res.ok) throw new Error('index load failed');
          return res.json();
        })
        .then(function (data) {
          indexData = data;
          return data;
        });
      return loading;
    }

    function scoreRecord(record, terms) {
      var title = record.title.toLowerCase();
      var desc = (record.description || '').toLowerCase();
      var text = (record.text || '').toLowerCase();
      var score = 0;

      for (var i = 0; i < terms.length; i += 1) {
        var term = terms[i];
        if (title.indexOf(term) !== -1) score += 10;
        if (desc.indexOf(term) !== -1) score += 4;
        if (text.indexOf(term) !== -1) score += 1;
      }
      return score;
    }

    function highlight(text, terms) {
      var out = escapeHtml(text);
      for (var i = 0; i < terms.length; i += 1) {
        if (terms[i].length < 2) continue;
        var re = new RegExp('(' + escapeRegExp(escapeHtml(terms[i])) + ')', 'gi');
        out = out.replace(re, '<mark>$1</mark>');
      }
      return out;
    }

    function render(query) {
      var q = (query || '').trim();
      list.innerHTML = '';

      if (!q) {
        status.textContent = '검색어를 입력해 주세요.';
        return;
      }

      status.textContent = '검색하는 중입니다.';

      loadIndex()
        .then(function (data) {
          var terms = q.toLowerCase().split(/\s+/).filter(Boolean);
          var scored = [];

          for (var i = 0; i < data.length; i += 1) {
            var s = scoreRecord(data[i], terms);
            if (s > 0) scored.push({ record: data[i], score: s });
          }

          scored.sort(function (a, b) {
            return b.score - a.score;
          });

          if (!scored.length) {
            status.textContent =
              '"' + q + '"에 대한 결과가 없습니다. 다른 단어로 검색해 보세요.';
            return;
          }

          status.textContent =
            '"' + q + '" 검색 결과 ' + scored.length + '건입니다.';

          var html = '';
          var limit = Math.min(scored.length, 30);
          for (var j = 0; j < limit; j += 1) {
            var r = scored[j].record;
            html +=
              '<li><a href="' +
              escapeHtml(r.url) +
              '"><h2>' +
              highlight(r.title, terms) +
              '</h2><p>' +
              highlight((r.description || '').slice(0, 140), terms) +
              '</p><small>' +
              escapeHtml(r.url) +
              '</small></a></li>';
          }
          list.innerHTML = html;
        })
        .catch(function () {
          status.textContent =
            '검색 정보를 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.';
        });
    }

    function updateUrl(q) {
      var url = new URL(window.location.href);
      if (q) {
        url.searchParams.set('q', q);
      } else {
        url.searchParams.delete('q');
      }
      window.history.replaceState({}, '', url);
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var q = input.value.trim();
      updateUrl(q);
      render(q);
    });

    var chips = document.querySelectorAll('.search-suggest button');
    for (var k = 0; k < chips.length; k += 1) {
      chips[k].addEventListener('click', function (event) {
        var term = event.currentTarget.getAttribute('data-term');
        input.value = term;
        updateUrl(term);
        render(term);
      });
    }

    var initial = new URLSearchParams(window.location.search).get('q') || '';
    if (initial) {
      input.value = initial;
      render(initial);
    } else {
      status.textContent = '검색어를 입력해 주세요.';
    }
  })();
</script>
