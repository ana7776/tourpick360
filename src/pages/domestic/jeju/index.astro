---
import Breadcrumb from '../../../components/Breadcrumb.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { allJejuArticles } from '../../../data/jejuApprovalArticles.js';

const areaBoard = [
  {
    name: '공항권 (제주시·용담·연동·노형)',
    summary: '늦은 도착, 이른 출발, 1박 짧은 일정에 유리합니다. 대신 동부·서부 관광지는 매일 왕복 이동이 길어질 수 있습니다.',
    href: '/domestic/jeju/jeju-hotel-area-guide/'
  },
  {
    name: '애월 (곽지·한담·하귀)',
    summary: '해안도로와 카페 감성이 강한 지역입니다. 주말 오후에는 도로 정체가 잦아 이동 시간을 넉넉히 잡아야 합니다.',
    href: '/domestic/jeju/jeju-hotel-area-guide/'
  },
  {
    name: '중문 (색달·대포·서귀포 서부)',
    summary: '리조트 부대시설이 모여 있어 숙소 안에서 보내는 시간이 긴 가족 여행에 유리합니다. 성수기 가격 변동이 큰 편입니다.',
    href: '/domestic/jeju/family-hotel-area-guide/'
  },
  {
    name: '성산 (섭지코지·표선·구좌 일부)',
    summary: '일출, 우도 방문 일정과 잘 맞습니다. 서부 숙소에서 매일 왕복하면 이동만으로 반나절이 소요될 수 있습니다.',
    href: '/domestic/jeju/jeju-hotel-area-guide/'
  }
];

const travelerGuides = [
  ['가족 여행', '객실 크기, 엑스트라 베드, 세탁 시설, 조식 운영 시간을 먼저 확인하고 관광지는 숙소 권역 중심으로 압축합니다.'],
  ['부모님 동반', '도보 거리와 계단, 주차장에서 숙소 입구까지 이동 거리를 우선 확인합니다.'],
  ['커플·기념일 여행', '사진 명소보다 저녁 복귀 동선과 숙소 주변 식사 후보를 함께 봅니다.'],
  ['렌터카 없는 여행', '제주시와 서귀포 시내는 대중교통으로 다닐 만하지만, 동부·서부 이동은 투어나 택시 비용을 함께 계산해야 합니다.']
];

const driveTimes = [
  ['제주공항 → 애월(한담)', '30~40분', '주말 오후 해안도로는 정체가 잦습니다.'],
  ['제주공항 → 중문', '60~70분', '평화로 이용 시 비교적 일정한 편입니다.'],
  ['제주공항 → 성산', '70~80분', '일출 일정이면 새벽 출발 시간을 역산해야 합니다.'],
  ['애월 → 중문', '40~50분', '중산간 도로는 안개가 끼는 날이 있습니다.'],
  ['중문 → 성산', '60~70분', '남쪽 해안 일주는 경치는 좋지만 시간이 더 걸립니다.'],
  ['성산 → 제주공항', '70~80분', '마지막 날에는 렌터카 반납 시간까지 더해야 합니다.']
];

const seasonNotes = [
  ['봄', '유채와 벚꽃 시기에 서부와 중산간 도로가 붐빕니다.', '사진 명소는 오전에 넣고 오후에는 실내나 숙소 권역으로 돌아옵니다.'],
  ['여름', '장마와 태풍 시기에는 항공편과 배편이 함께 흔들립니다.', '야외 일정 하나마다 실내 대체 코스를 미리 정해 둡니다.'],
  ['가을', '날씨가 가장 안정적이지만 숙소 요금과 예약 경쟁이 높습니다.', '숙소를 먼저 확보하고 코스를 뒤에 맞추는 순서가 낫습니다.'],
  ['겨울', '바람이 강하고 한라산 방향 도로는 결빙·통제가 생길 수 있습니다.', '해안 산책 대신 실내 일정을 늘리고 이동 거리를 줄입니다.']
];

const bookingSteps = [
  ['1단계', '가장 멀리 가고 싶은 관광지 한두 곳을 먼저 정합니다.'],
  ['2단계', '그 관광지까지 이동 시간을 기준으로 숙소 권역 후보를 2곳으로 좁힙니다.'],
  ['3단계', '렌터카 인수·반납 장소와 무료 주차 가능 여부를 확인합니다.'],
  ['4단계', '3박 이상이면 숙소를 1~2곳으로 나눌지 정하고 이동일에는 일정을 가볍게 둡니다.']
];
const breadcrumbItems = [
  { name: '국내여행', href: '/domestic/' },
  { name: '제주 여행', href: '/domestic/jeju/' }
];
---
<BaseLayout title="제주 여행 가이드 - Tourpick360" description="제주 숙소 권역, 렌터카 동선, 가족 여행 코스, 비 오는 날 대체 일정과 계절별 여행 준비 기준을 비교해 정리합니다.">
  <section class="page category-page">
    <Breadcrumb items={breadcrumbItems} />
    <p class="eyebrow">Jeju Guide</p>
    <h1>제주 여행 가이드</h1>
    <p class="lead">제주는 숙소 위치에 따라 여행 만족도가 크게 달라집니다. Tourpick360은 공항권, 애월, 중문, 성산을 단순 추천 순위가 아니라 도착 편의성, 식사 접근성, 날씨 대응, 가족 편의성 같은 360도 기준으로 비교합니다.</p>
    <figure class="article-hero-image">
      <img src="/images/tourapi/jeju_yongduam.jpg" alt="제주 여행 권역 계획 참고 이미지" width="1200" height="675" loading="eager" />
      <figcaption>제주 일정은 공항 접근성과 숙소 권역, 날씨 대비, 렌터카 인수 반납 시간에서 시작됩니다.</figcaption>
    </figure>
    <div class="category-summary">
      <div>
        <strong>{allJejuArticles.length}</strong>
        <span>제주 핵심 가이드</span>
      </div>
      <div>
        <strong>4</strong>
        <span>숙소 권역 비교</span>
      </div>
      <div>
        <strong>2026.08.23</strong>
        <span>최종 구조 점검일</span>
      </div>
    </div>
  </section>

  <section class="domestic-board">
    <div class="board-intro">
      <p class="eyebrow">Area Comparison</p>
      <h2>제주 숙소 권역 4곳 비교</h2>
      <p>같은 제주라도 권역마다 어울리는 일정이 다릅니다. 관광지 유명세보다 숙소에서 관광지까지 이동 시간과 날씨 변수 대응을 먼저 비교하세요.</p>
    </div>
    <div class="region-board">
      {areaBoard.map((row, index) => (
        <a class="region-row" href={row.href}>
          <span class="region-number">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{row.name}</h3>
            <p>{row.summary}</p>
          </div>
          <dl>
            <div>
              <dt>핵심</dt>
              <dd>이동 시간</dd>
            </div>
            <div>
              <dt>목적</dt>
              <dd>동선 압축</dd>
            </div>
          </dl>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Drive Time</p>
      <h2>권역 사이 이동 시간부터 계산합니다</h2>
      <p class="muted">제주 일정이 무너지는 가장 큰 이유는 관광지가 부족해서가 아니라 하루에 넣은 권역이 많기 때문입니다. 제주는 지도상으로는 작아 보여도 동서 이동에 한 시간 이상이 걸리고, 여기에 주차와 식사 대기가 더해집니다. 숙소를 정하기 전에 아래 이동 시간을 먼저 확인하세요.</p>
    </div>
    <table>
      <thead>
        <tr><th>구간</th><th>예상 차량 이동</th><th>메모</th></tr>
      </thead>
      <tbody>
        {driveTimes.map(([section, time, memo]) => (
          <tr><td><strong>{section}</strong></td><td>{time}</td><td>{memo}</td></tr>
        ))}
      </tbody>
    </table>
    <p class="muted">표의 시간은 정체가 없을 때를 기준으로 한 참고값입니다. 실제 소요 시간은 요일, 날씨, 행사 유무에 따라 달라지므로 출발 전 실시간 안내를 확인하고, 하루 일정에는 구간마다 20분 정도의 여유를 더해 두는 편이 안전합니다. 3박 이상이면 숙소를 동부와 서부로 나누는 방법이 왕복 이동을 크게 줄여 줍니다.</p>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Season</p>
      <h2>계절이 일정의 절반을 결정합니다</h2>
      <p class="muted">제주는 같은 코스라도 계절에 따라 난이도가 달라집니다. 특히 바람과 항공편은 다른 지역보다 변수가 큽니다.</p>
    </div>
    <table>
      <thead>
        <tr><th>계절</th><th>변수</th><th>대응</th></tr>
      </thead>
      <tbody>
        {seasonNotes.map(([season, risk, plan]) => (
          <tr><td><strong>{season}</strong></td><td>{risk}</td><td>{plan}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="domestic-routes">
    <div>
      <p class="eyebrow">Traveler Type</p>
      <h2>동행 유형별로 달라지는 제주 숙소 선택 기준</h2>
      <p>같은 권역이라도 누구와 가는지에 따라 확인할 우선순위가 달라집니다.</p>
    </div>
    <div class="route-notes">
      {travelerGuides.map(([title, body]) => (
        <section>
          <h3>{title}</h3>
          <p>{body}</p>
        </section>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Articles</p>
      <h2>제주 콘텐츠 목록</h2>
    </div>
    <div class="article-grid">
      {allJejuArticles.map((item) => (
        <article class="article-card">
          <p>{item.category}</p>
          <h3><a href={item.href}>{item.title}</a></h3>
          <span>{item.summary}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="checklist-roadmap">
    <p class="eyebrow">Booking Flow</p>
    <h2>제주 숙소 예약 전 확인 순서</h2>
    <ol>
      {bookingSteps.map(([step, body]) => (
        <li><strong>{step}</strong><span>{body}</span></li>
      ))}
    </ol>
    <p class="muted">예약을 마친 뒤에는 렌터카 반납 시각을 항공편 출발 시각에서 역산해 일정표에 적어두세요. 마지막 날 일정이 어디까지 가능한지가 그 시각 하나로 정해집니다. 자세한 계산 방법은 <a href="/travel-tips/rental-car-checklist/">렌터카 예약 전 확인해야 할 10가지</a>와 <a href="/travel-tips/problems/jeju-rental-car-return-last-day-plan/">마지막 날 렌터카 반납 일정 조정법</a>에 정리해 두었습니다.</p>
    <p class="muted">이 허브의 제주 글은 직접 방문하지 않고 공식 안내와 공개 자료를 정리한 준비용 가이드입니다. 요금, 운영 시간, 도로 통제와 항공편 운항은 시점에 따라 달라지므로 출발 전 공식 채널에서 다시 확인하세요. 최종 확인일: 2026년 8월 23일.</p>
  </section>
</BaseLayout>
