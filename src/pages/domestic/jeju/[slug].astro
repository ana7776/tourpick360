---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ApprovalArticle from '../../../components/ApprovalArticle.astro';
import { jejuApprovalArticles, allJejuArticles } from '../../../data/jejuApprovalArticles.js';
import { buildSearchDescription, buildSearchTitle } from '../../../utils/searchSnippets.js';

export function getStaticPaths() {
  return jejuApprovalArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const related = allJejuArticles.filter((item) => item.title !== article.title).slice(0, 4);
const seoTitle = buildSearchTitle(article, '숙소·동선 선택');
const seoDescription = buildSearchDescription(article);
---
<BaseLayout title={seoTitle} description={seoDescription}>
  <ApprovalArticle article={article} related={related} />
</BaseLayout>
