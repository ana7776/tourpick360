---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sourceUrl = 'https://www.bike.go.kr/content.do?key=2008069223071';
const bicycleCategoryUrl = '/domestic/bicycle/';
const bicycleApiUrl = '/api/bicycle-routes.json';

const routeTypes = [
  {
    label: '강변 입문',
    title: '처음이면 왕복보다 편도 회수 동선을 먼저 잡기',
    routes: ['한강 자전거길', '북한강 자전거길', '남한강 자전거길'],
    note: '대여소, 지하철역, 편의점, 화장실이 촘촘한 구간을 짧게 끊으면 초보도 부담이 적습니다.'
  },
  {
    label: '가족 여행',
    title: '차도 접점이 적고 쉼터가 많은 구간 고르기',
    routes: ['아라 자전거길', '섬진강 자전거길 일부', '낙동강 하굿둑 주변 평탄 구간'],
    note: '아이와 함께라면 거리보다 복귀 방법, 그늘, 화장실, 식사 위치가 더 중요합니다.'
  },
  {
    label: '해안 풍경',
    title: '바람과 언덕을 일정표에 반영하기',
    routes: ['동해안 자전거길', '제주 환상 자전거길', '오천 자전거길 주변 구간'],
    note: '바다길은 사진 만족도가 높지만 맞바람과 노출 구간이 있어 체감 난도가 쉽게 올라갑니다.'
  },
  {
    label: '종주 준비',
    title: '한 번에 완주보다 구간 인증부터 시작하기',
    routes: ['국토종주 낙동강 자전거길', '금강 자전거길', '영산강 자전거길'],
    note: '장거리 종주는 숙소, 보급, 수리점, 우천 대체 이동수단까지 함께 확인해야 실패가 줄어듭니다.'
  }
];

const oneDayPicks = [
  {
    name: '서울 한강 반나절 코스',
    fit: '초보, 커플, 가족',
    plan: '자전거 대여 - 강변 카페 또는 편의점 휴식 - 반납 지점 복귀',
    reason: '대중교통 접근성이 좋고 중간 이탈이 쉬워 첫 자전거 여행 테스트로 좋습니다.'
  },
  {
    name: '아라 자전거길 가벼운 왕복',
    fit: '가족, 입문자',
    plan: '평탄 구간 위주로 10-20km만 잡고 식사 지점을 먼저 고정',
    reason: '길 폭과 휴식 여건이 비교적 안정적이라 속도보다 경험에 집중하기 좋습니다.'
  },
  {
    name: '북한강 역 연계 코스',
    fit: '대중교통 여행자',
    plan: '전철 접근 가능한 역을 기준으로 편도 또는 짧은 왕복 구성',
    reason: '차 없이도 접근 가능한 구간이 있어 숙박 없는 당일 여행으로 설계하기 쉽습니다.'
  },
  {
    name: '제주 해안 일부 구간',
    fit: '사진 여행, 1박 이상',
    plan: '전 구간 욕심보다 숙소 주변 1-2개 구간만 선택',
    reason: '제주는 풍경 만족도가 높지만 바람과 이동 시간이 커서 일부 구간 체험형이 현실적입니다.'
  }
];

const checklist = [
  ['거리', '초보는 하루 20km 안팎부터 시작하고, 사진·식사·휴식 시간을 별도로 잡습니다.'],
  ['복귀', '왕복인지 편도인지, 지하철·버스·택시·차량 회수가 가능한지 먼저 확인합니다.'],
  ['대여', '현장 대여소 운영 시간, 신분증 필요 여부, 반납 가능 지점을 확인합니다.'],
  ['안전', '헬멧, 전조등, 후미등, 장갑, 물, 간단한 정비 도구를 준비합니다.'],
  ['날씨', '강풍·폭염·비 예보가 있으면 강변과 해안 구간은 과감히 줄입니다.'],
  ['보급', '편의점, 화장실, 식당, 그늘 쉼터 위치를 지도에 저장합니다.']
];

const sampleTimeline = [
  ['09:30', '출발지 도착', '대여소 운영 시간과 반납 지점을 먼저 확인합니다.'],
  ['10:00', '자전거 대여', '안장 높이, 브레이크, 타이어 공기압을 출발 전 확인합니다.'],
  ['10:20', '강변 또는 해안 자전거길 진입', '초보자는 첫 20분 동안 속도를 올리지 않는 편이 좋습니다.'],
  ['11:20', '첫 휴식', '사진 촬영, 물 보충, 손목과 무릎 상태를 확인합니다.'],
  ['12:10', '점심', '자전거 보관이 쉬운 식당이나 포장 가능한 메뉴를 고릅니다.'],
  ['13:30', '복귀 또는 편도 회수', '체력이 떨어지기 전 반납 지점으로 방향을 바꿉니다.'],
  ['14:30', '반납과 정산', '대여 연장 요금, 주차비, 간식비까지 함께 기록합니다.']
];

const sampleBudgetRows = [
  ['자전거 대여', '2인 3시간 기준 예시', '20,000원'],
  ['점심', '간단한 식사 2인', '24,000원'],
  ['음료·간식', '물, 커피, 보급 간식', '12,000원'],
  ['교통', '대중교통 또는 주차비', '8,000원'],
  ['예비비', '연장 대여·우천 대체 이동', '10,000원']
];

const routeCards = [
  {
    title: '국토종주 자전거길',
    summary: '인천에서 부산까지 이어지는 장거리 축을 포함해 한강, 낙동강, 금강, 영산강 등 주요 강길을 연결합니다.',
    use: '완주 목적보다 1개 강 구간을 먼저 경험한 뒤 종주 계획으로 확장하는 편이 안전합니다.'
  },
  {
    title: '아름다운 자전거길 100선',
    summary: '접근성, 안전성, 경관, 주변 볼거리와 먹거리 등을 함께 고려해 소개되는 추천 자전거길입니다.',
    use: '목록을 그대로 따라가기보다 숙소·식사·대중교통 위치와 맞는 구간만 골라 여행 코스로 재구성합니다.'
  },
  {
    title: '섬 자전거길',
    summary: '섬의 해안 풍경과 마을길을 중심으로 구성된 자전거 여행 후보지입니다.',
    use: '배편, 바람, 언덕, 숙소 수가 변수이므로 당일치기보다 여유 있는 일정에 어울립니다.'
  }
];

const relatedLinks = [
  { title: '국내여행 허브', href: '/domestic/' },
  { title: '비 오는 날 국내여행 동선 바꾸는 법', href: '/travel-tips/problems/rainy-trip-route-change/' },
  { title: '렌터카 예약 전 확인해야 할 10가지', href: '/travel-tips/rental-car-checklist/' },
  { title: '국내여행 예산표 짜는 법', href: '/travel-tips/travel-budget-plan/' }
];
---
<BaseLayout
  title="국내 자전거 여행길 고르는 법 - 멈춤 지점과 복귀 동선 중심 가이드"
  description="공식 자전거길 자료를 참고하되 초보, 가족, 해안, 강변, 장거리 여행자가 실제 일정에서 확인해야 할 대여·보급·복귀 기준으로 새롭게 정리했습니다."
  image="/images/bicycle-route-guide.svg"
>
  <article class="article-page longform bike-guide-page">
    <p class="eyebrow">국내 자전거 여행</p>
    <h1>자전거 여행길은 “어디가 유명한가”보다 “어디서 멈출 수 있나”가 먼저입니다</h1>
    <p class="lead">
      자전거길은 목록만 보면 모두 좋아 보이지만, 실제 여행에서는 복귀 동선, 대여 가능 여부, 휴식 지점,
      바람과 언덕, 식사 위치가 만족도를 가릅니다. 이 글은 공식 자전거길 자료를 원문 확인용 기준으로 삼고,
      Tourpick360의 여행 준비 관점에서 코스를 고르는 법을 새롭게 정리한 글입니다.
    </p>

    <figure class="article-hero-image">
      <img src="/images/bicycle-route-guide.svg" alt="강변과 해안 자전거 여행길을 비교하는 일러스트 지도" width="1200" height="675" loading="eager" />
      <figcaption>자전거 여행은 거리보다 회수 동선, 휴식 지점, 날씨 변수를 먼저 잡아야 일정이 안정됩니다.</figcaption>
    </figure>

    <section class="travel-summary-panel" aria-labelledby="bike-guide-quick-info">
      <div>
        <p class="eyebrow">Quick Info</p>
        <h2 id="bike-guide-quick-info">자전거 여행길 정보 시트</h2>
        <p>
          공식 자전거길 목록을 여행자가 바로 일정에 적용할 수 있도록 거리, 복귀, 대여, 안전, 보급 기준으로 다시 해석했습니다.
        </p>
      </div>
      <dl>
        <div><dt>테마</dt><dd>국내 자전거 여행</dd></div>
        <div><dt>추천 대상</dt><dd>초보, 가족, 강변·해안 여행자</dd></div>
        <div><dt>난이도</dt><dd>입문 구간 하, 해안·종주 중상</dd></div>
        <div><dt>확인일</dt><dd>2026년 7월 6일</dd></div>
      </dl>
    </section>

    <section class="article-section source-panel">
      <div>
        <p class="eyebrow">자전거 여행길 카테고리</p>
        <h2>공식 자전거길 정보를 여행 계획 언어로 바꿨습니다</h2>
        <p>
          공식 페이지는 원문 확인용으로 연결하고, 이 글에서는 독자가 바로 판단할 수 있도록 “얼마나 멀리 탈까”보다
          “어디서 쉬고, 어디서 먹고, 어떻게 돌아올까”를 먼저 다룹니다. 내부 카테고리와 추천 코스는 JSON API로도 정리했습니다.
        </p>
      </div>
      <div class="source-links">
        <a href={bicycleCategoryUrl}>자전거 여행길 카테고리<span>국토종주 · 100선 · 섬·해안 · 입문</span></a>
        <a href={bicycleApiUrl}>Tourpick360 JSON API<span>{bicycleApiUrl}</span></a>
      </div>
    </section>

    <section class="route-plan-box">
      <h2>자전거 여행길을 고르는 4가지 기준</h2>
      <ol>
        {routeTypes.map((item) => (
          <li>
            <strong>{item.label}: {item.title}</strong>
            <span>{item.routes.join(' · ')}</span>
            <p>{item.note}</p>
          </li>
        ))}
      </ol>
    </section>

    <h2>당일 여행으로 시작하기 좋은 자전거길</h2>
    <div class="guide-feed-grid compact-grid">
      {oneDayPicks.map((item) => (
        <article>
          <span>{item.fit}</span>
          <h3>{item.name}</h3>
          <p><strong>추천 흐름:</strong> {item.plan}</p>
          <p>{item.reason}</p>
        </article>
      ))}
    </div>

    <section class="route-plan-box" aria-labelledby="sample-bike-timeline-heading">
      <p class="eyebrow">번호형 코스 예시</p>
      <h2 id="sample-bike-timeline-heading">자전거 대여 당일치기 기본 타임라인</h2>
      <ol>
        {sampleTimeline.map(([time, title, note]) => (
          <li>
            <strong>{time} {title}</strong>
            <span>{note}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="expense-table-box" aria-labelledby="sample-bike-budget-heading">
      <p class="eyebrow">2인 기준 예산 예시</p>
      <h2 id="sample-bike-budget-heading">자전거 여행 당일치기 경비표</h2>
      <p>아직 실제 후기를 넣기 전이라면 아래처럼 항목을 나눠 기록해 두면 됩니다. 직접 다녀온 날에는 영수증 기준 금액으로 바꿔 넣는 것이 가장 좋습니다.</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">구분</th>
              <th scope="col">세부 내역</th>
              <th scope="col">금액</th>
            </tr>
          </thead>
          <tbody>
            {sampleBudgetRows.map(([type, detail, amount]) => (
              <tr>
                <th scope="row">{type}</th>
                <td>{detail}</td>
                <td>{amount}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">합계</th>
              <td>2인 당일치기 기본 예산</td>
              <td>74,000원</td>
            </tr>
            <tr>
              <th scope="row">1인 기준</th>
              <td>2인으로 나눈 예상 금액</td>
              <td>37,000원</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>

    <h2>공식 자전거길 정보는 이렇게 활용하면 좋습니다</h2>
    <p>
      자전거행복나눔의 공식 자료는 국토종주 자전거길, 아름다운 자전거길 100선, 섬 자전거길처럼
      큰 분류를 확인하기에 좋습니다. 다만 실제 여행 글로 옮길 때는 전체 목록을 반복하기보다
      “초보가 탈 수 있는 짧은 구간”, “대중교통으로 회수 가능한 구간”, “해안 풍경은 좋지만 바람을
      조심해야 하는 구간”처럼 여행자의 선택 기준으로 다시 묶는 편이 유용합니다.
    </p>
    <p>
      공식 정보 확인: <a href={sourceUrl} target="_blank" rel="noopener noreferrer">자전거행복나눔 자전거길 안내</a>
    </p>

    <div class="related-grid">
      {routeCards.map((card) => (
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
          <span>여행 기준 재해석</span>
          <strong>{card.title}</strong>
          <p>{card.summary}</p>
          <p>{card.use}</p>
        </a>
      ))}
    </div>

    <h2>초보자가 실패하지 않는 준비 체크리스트</h2>
    <div class="route-notes">
      {checklist.map(([title, text]) => (
        <section>
          <h3>{title}</h3>
          <p>{text}</p>
        </section>
      ))}
    </div>

    <h2>Tourpick360식 추천 순서</h2>
    <p>
      첫 자전거 여행은 유명한 인증센터를 목표로 잡기보다, “대여와 반납이 쉬운 강변 10-20km”로 시작하는 편이 좋습니다.
      두 번째는 북한강이나 아라처럼 편도 회수가 쉬운 구간을 고르고, 세 번째부터 해안이나 섬 자전거길을 넣어도 늦지 않습니다.
      국토종주는 그 다음 단계입니다. 하루에 많이 타는 계획보다 다음 날 무릎과 손목이 괜찮은 계획이 더 오래 갑니다.
    </p>

    <h2>함께 보면 좋은 내부 가이드</h2>
    <div class="related-grid">
      {relatedLinks.map((item) => (
        <a href={item.href}>
          <span>Tourpick360</span>
          <strong>{item.title}</strong>
        </a>
      ))}
    </div>

    <section class="source-note">
      <h2>참고문헌과 업데이트 로그</h2>
      <p>공식 출처: <a href={sourceUrl} target="_blank" rel="noopener noreferrer">자전거행복나눔 아름다운 자전거길 100선</a></p>
      <p>내부 데이터: <a href={bicycleCategoryUrl}>자전거 여행길 카테고리</a>, <a href={bicycleApiUrl}>자전거길 JSON API</a></p>
      <p>최종 확인일: 2026년 7월 6일. 공식 목록은 원문을 확인하고, 본문은 Tourpick360의 여행 계획 기준으로 독자에게 필요한 판단 순서와 준비 포인트를 새로 작성했습니다.</p>
