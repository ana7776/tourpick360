---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  beautifulBicycleRoutes100,
  bicycleCategories,
  bicycleOfficialSource,
  bicyclePlannerSteps,
  bicycleRoutePicks,
  bicycleRouteRegions,
  getBicycleRoutePlanningNote,
  nationalBicycleRouteGroups
} from '../../../data/bicycleTravel.js';
---

<BaseLayout
  title="자전거 여행길 고르는 법 - 초보·가족·해안 코스 Tourpick360 가이드"
  description="공식 자전거길 자료를 바탕으로 대여, 반납, 점심, 화장실, 바람, 복귀 동선까지 따져 국내 자전거 여행길을 새롭게 재구성했습니다."
  image="/images/bicycle-route-guide.svg"
>
  <article class="article-page bicycle-category-page">
    <section class="article-hero split-hero">
      <div>
        <p class="eyebrow">국내 여행 카테고리</p>
        <h1>자전거 여행길은 이름보다 하루의 리듬으로 골라야 합니다</h1>
        <p class="lead">
          유명한 자전거길도 대여소가 멀거나, 점심을 놓치거나, 돌아오는 방법이 애매하면 좋은 여행이 되기 어렵습니다.
          Tourpick360은 공식 목록을 출발점으로 삼되 대여·반납, 쉬는 지점, 복귀 동선, 사진 체류 시간까지 더해
          실제로 다녀오기 쉬운 여행길로 다시 읽습니다.
        </p>
        <div class="hero-actions">
          <a class="primary-button" href="/domestic/bicycle-routes-guide/">코스 고르는 법 보기</a>
          <a class="secondary-button" href={bicycleOfficialSource.apiPath}>자전거길 API 보기</a>
        </div>
      </div>
      <figure>
        <img src="/images/bicycle-route-guide.svg" alt="강변과 해안 자전거 여행길을 비교하는 지도형 이미지" width="1200" height="675" loading="eager" />
        <figcaption>자전거 여행은 멋진 길을 찾는 일보다, 멈추고 돌아올 수 있는 지점을 설계하는 일이 먼저입니다.</figcaption>
      </figure>
    </section>

    <section class="article-section source-panel">
      <div>
        <p class="eyebrow">Tourpick360 재구성 기준</p>
        <h2>공식 목록에 여행자의 판단 기준을 덧붙였습니다</h2>
        <p>
          원문 목록은 길의 이름과 큰 분류를 확인하는 데 유용합니다. 이 페이지에서는 거기에 초보자 체력,
          가족 동반 여부, 식사와 보급, 비나 강풍이 왔을 때 빠져나오는 방법을 붙여 여행 계획용으로 새롭게 정리했습니다.
        </p>
      </div>
      <div class="source-links">
        <a href={bicycleOfficialSource.url} target="_blank" rel="noopener noreferrer">
          공식 자전거길 안내
          <span>{bicycleOfficialSource.organization}</span>
        </a>
        <a href={bicycleOfficialSource.apiPath}>
          자전거길 정리 데이터
          <span>{bicycleOfficialSource.apiPath}</span>
        </a>
      </div>
    </section>

    <section class="travel-summary-panel" aria-labelledby="bike-quick-info">
      <div>
        <p class="eyebrow">Quick Info</p>
        <h2 id="bike-quick-info">자전거 여행 선택 시트</h2>
        <p>
          목록은 그대로 베끼는 대신, 독자가 “내 일정에 맞는가”를 판단할 수 있도록 구간 성격과 준비 포인트를 함께 보여줍니다.
        </p>
      </div>
      <dl>
        <div><dt>공식 출처</dt><dd>{bicycleOfficialSource.organization}</dd></div>
        <div><dt>원문 확인</dt><dd>{bicycleOfficialSource.sourceCheckedDate}</dd></div>
        <div><dt>정리 범위</dt><dd>{beautifulBicycleRoutes100.length}개 공식 후보를 여행 기준으로 해석</dd></div>
        <div><dt>API</dt><dd>{bicycleOfficialSource.apiPath}</dd></div>
      </dl>
    </section>

    <section class="article-section">
      <div class="section-heading">
        <p class="eyebrow">카테고리</p>
        <h2>자전거 여행길 4개 분류</h2>
      </div>
      <div class="bicycle-category-grid">
        {bicycleCategories.map((category) => (
          <article class="bicycle-category-card">
            <span>{category.label}</span>
            <h3>{category.title}</h3>
            <p>{category.summary}</p>
            <dl>
              <div>
                <dt>추천 대상</dt>
                <dd>{category.bestFor}</dd>
              </div>
              <div>
                <dt>예시 코스</dt>
                <dd>{category.routeExamples.join(' · ')}</dd>
              </div>
            </dl>
            <p class="card-note">{category.tourpickAngle}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="article-section">
      <div class="section-heading">
        <p class="eyebrow">지역별 선택표</p>
        <h2>100개 자전거길을 여행 준비 기준으로 다시 읽기</h2>
        <p>
          아래 표의 번호와 코스명은 공식 명칭 확인을 돕기 위한 기준점입니다. Tourpick360은 여기에 해안형, 강변형,
          관광지 결합형, 오르막 변수처럼 실제 여행자가 먼저 따져야 할 메모를 붙였습니다. 이후 직접 다녀온 코스는
          사진, 경비표, 접근 동선이 확보되는 순서대로 별도 후기 글로 확장합니다.
        </p>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">지역</th>
              <th scope="col">번호</th>
              <th scope="col">자전거길</th>
              <th scope="col">Tourpick360 활용 기준</th>
            </tr>
          </thead>
          <tbody>
            {bicycleRouteRegions.map((group) => (
              <>
                {group.routes.map((route, index) => (
                  <tr id={`bike-route-${route.no}`}>
                    {index === 0 && <th scope="rowgroup" rowspan={group.routes.length}>{group.region}</th>}
                    <td>{String(route.no).padStart(3, '0')}</td>
                    <td>{route.name}</td>
                    <td>{getBicycleRoutePlanningNote(route, 'ko')}</td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="article-section">
      <div class="section-heading">
        <p class="eyebrow">국토종주 축</p>
        <h2>국토종주 자전거길은 거리보다 구간 분리가 먼저입니다</h2>
      </div>
      <div class="route-pick-grid">
        {nationalBicycleRouteGroups.map((route) => (
          <article>
            <span>{route.distance}</span>
            <h3>{route.name}</h3>
            <p><strong>구간:</strong> {route.section}</p>
            <p><strong>100선 연결 번호:</strong> {route.relatedNumbers.map((number) => String(number).padStart(3, '0')).join(', ')}</p>
            <p>{route.tourpickUse}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="article-section">
      <div class="section-heading">
        <p class="eyebrow">계획 흐름</p>
        <h2>공식 정보에서 내 여행 코스로 바꾸는 순서</h2>
      </div>
      <ol class="route-plan-box">
        {bicyclePlannerSteps.map((item) => (
          <li>
            <span>{item.step}</span>
            <strong>{item.title}</strong>
            <p>{item.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="article-section">
      <div class="section-heading">
        <p class="eyebrow">추천 시작점</p>
        <h2>처음 확장하기 좋은 자전거 여행길</h2>
      </div>
      <div class="route-pick-grid">
        {bicycleRoutePicks.map((route) => (
          <article>
            <span>{route.category}</span>
            <h3>{route.name}</h3>
            <p><strong>거리 기준</strong> {route.distance}</p>
            <p><strong>흐름</strong> {route.rhythm}</p>
            <p>{route.reason}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="article-section next-guide-panel">
      <div>
        <h2>다음 보강은 실제 후기형 글이 가장 좋습니다</h2>
        <p>
          자전거를 대여한 날의 경비표, 시간표, 직접 찍은 사진, 포기한 후보지까지 함께 남기면
          단순 목록보다 독자에게 훨씬 유용한 경험형 콘텐츠가 됩니다.
        </p>
      </div>
      <a class="primary-button" href="/domestic/bicycle-routes-guide/">자전거 여행길 고르는 법</a>
    </section>

    <section class="source-note">
      <h2>출처와 업데이트 로그</h2>
      <p>공식 출처: <a href={bicycleOfficialSource.url} target="_blank" rel="noopener noreferrer">{bicycleOfficialSource.name}</a></p>
      <p>최종 확인일: {bicycleOfficialSource.sourceCheckedDate}. 공식 목록은 원문 확인용으로 연결하고, Tourpick360 본문은 대여·반납·보급·복귀 동선·동행자 기준으로 새롭게 작성했습니다.</p>
      <p>업데이트 기록: 2026년 7월 6일, 지역별 선택표와 국토종주 축, 여행 준비 메모를 추가했습니다.</p>
    </section>
  </article>
</BaseLayout>
