---
import SourceBadge from '../../../components/SourceBadge.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTourApiImage } from '../../../data/tourApiImages.js';

const heroImage = getTourApiImage('gyeongju', {
  src: '/images/domestic-places/gyeongju-daereungwon-hero.jpg',
  alt: '경주 대릉원 고분과 산책로 풍경',
  caption: '경주는 대릉원, 황리단길, 첨성대처럼 가까워 보이는 지점도 실제 걷는 피로를 함께 봐야 합니다. 사진: Bernard Gagnon, Wikimedia Commons, CC0'
});

const areaRows = [
  ['황리단길·대릉원', '도보 중심 1박 2일, 첫 경주 여행', '식사, 카페, 유적, 야간 산책을 한 권역에서 해결할 수 있습니다.', '주말 차량 진입과 주차가 까다로워 숙소 전용 주차 여부를 먼저 봅니다.'],
  ['보문관광단지', '휴식형 일정, 가족·부모님 동반', '호수 산책로와 대형 숙소가 모여 있어 이동 없이 쉬기 좋습니다.', '시내 유적까지는 차량이나 버스 이동이 필요합니다.'],
  ['불국사·동경주', '불국사와 석굴암 중심 일정', '아침 일찍 붐비기 전에 관람을 시작할 수 있습니다.', '식사와 야간 선택지가 적어 저녁 계획을 따로 세워야 합니다.'],
  ['경주역·터미널 주변', '대중교통 이용, 짐이 많은 일정', '도착과 출발이 단순하고 짐 이동 부담이 적습니다.', '관광 권역과 떨어져 있어 매일 이동이 한 번씩 생깁니다.']
];

const walkRows = [
  ['대릉원 → 첨성대', '도보 10~15분', '평지 구간이라 부담이 적습니다.'],
  ['첨성대 → 동궁과 월지', '도보 20~25분', '가로등이 있는 길이지만 밤에는 인적이 줄어듭니다.'],
  ['황리단길 → 국립경주박물관', '도보 25~30분', '더운 날에는 버스나 택시로 나누는 편이 낫습니다.'],
  ['동궁과 월지 → 월정교', '도보 20분 안팎', '야간 조명 구간이라 저녁 코스로 묶기 좋습니다.'],
  ['시내 권역 → 보문단지', '차량 15~20분', '걸어서 이동하는 구간이 아닙니다.'],
  ['시내 권역 → 불국사', '차량 25~30분', '버스는 배차 간격을 먼저 확인해야 합니다.']
];

const companionRows = [
  ['아이 동반', '하루 도보 6,000보 안팎', '오후에는 숙소 복귀 시간을 반드시 넣습니다.'],
  ['부모님 동반', '하루 도보 5,000보 안팎', '유적 사이 이동은 택시로 끊어 주는 편이 만족도가 높습니다.'],
  ['친구·커플', '하루 도보 12,000보 이상 가능', '야간 코스를 넣어도 다음 날 일정에 무리가 적습니다.'],
  ['혼자 여행', '체력에 따라 조절', '카페 대기와 사진 촬영 시간을 넉넉히 잡는 편이 좋습니다.']
];

const seasonRows = [
  ['봄', '벚꽃 시기 보문호 주변과 시내 도로가 크게 혼잡합니다.', '주차장 진입 대기를 감안해 아침 일찍 움직입니다.'],
  ['여름', '유적 구간은 그늘이 적어 한낮 도보가 힘듭니다.', '오전과 해 진 뒤로 도보 코스를 나눕니다.'],
  ['가을', '날씨가 가장 걷기 좋지만 주말 숙소가 빨리 찹니다.', '숙소를 먼저 잡고 코스를 맞추는 순서가 낫습니다.'],
  ['겨울', '해가 짧아 야간 코스 시작 시각이 앞당겨집니다.', '바람이 강한 날 호수와 개활지 구간은 체감온도가 낮습니다.']
];

const breadcrumbItems = [
  { name: '국내여행', href: '/domestic/' },
  { name: '경주 도보 여행 코스와 숙소 위치 고르는 법', href: '/domestic/gyeongju/walking-route-hotel-area-guide/' }
];
---
<BaseLayout title="경주 도보 여행 코스와 숙소 위치 고르는 법 - Tourpick360" description="경주 여행에서 황리단길, 대릉원, 첨성대, 월정교, 보문단지 권역을 실제 도보 시간과 동행 유형 기준으로 비교해 숙소 위치를 정하는 방법입니다.">
  <article class="article-page longform">
    <Breadcrumb items={breadcrumbItems} />
    <p class="eyebrow">경주 도보여행</p>
    <h1>경주 도보 여행 코스와 숙소 위치 고르는 법</h1>
    <SourceBadge />
    <p class="lead">경주는 걷는 시간이 많은 도시입니다. 지도상 거리가 가까워 보여도 사진 촬영, 카페 대기, 야간 산책까지 더해지면 하루 피로가 커질 수 있어 숙소 위치와 도보 코스를 함께 봐야 합니다. 특히 유적이 한 곳에 모여 있지 않고 여러 지구로 흩어져 있다는 점이 다른 도시와 가장 다른 부분입니다.</p>

    <figure class="article-hero-image">
      <img src={heroImage.src} alt={heroImage.alt} width="960" height="540" loading="eager" />
      <figcaption>{heroImage.caption}</figcaption>
    </figure>

    <h2>핵심 요약</h2>
    <table>
      <tbody>
        <tr><th>추천 대상</th><td>경주 1박 2일 첫 방문자, 부모님·아이와 함께 걷는 일정, 차 없이 대중교통으로 움직이는 여행자</td></tr>
        <tr><th>핵심 권역</th><td>황리단길·대릉원, 보문관광단지, 불국사·동경주, 경주역 주변</td></tr>
        <tr><th>판단 기준</th><td>하루에 감당할 도보량을 먼저 정하고, 그 안에 들어오는 권역만 같은 날에 묶습니다.</td></tr>
        <tr><th>주의사항</th><td>관람 시간, 야간 개방 여부, 주차장 운영은 시기마다 달라지므로 방문 전 공식 안내를 확인해야 합니다.</td></tr>
      </tbody>
    </table>

    <h2>경주는 한 도시가 아니라 여러 권역으로 나뉘어 있습니다</h2>
    <p>경주 여행에서 첫날이 무너지는 가장 흔한 이유는 대릉원과 불국사, 보문단지를 같은 날에 넣었기 때문입니다. 시내 유적은 걸어서 이어지지만 불국사와 석굴암은 토함산 방향이고, 보문단지는 호수를 낀 별도 권역입니다. 세 곳을 하루에 모두 보려면 이동에만 두 시간 가까이 들어가고, 그만큼 유적 앞에서 머무는 시간이 줄어듭니다.</p>
    <p>그래서 경주에서는 <strong>숙소 권역이 곧 그날의 코스</strong>가 됩니다. 시내 도보 코스를 중심에 둘지, 휴식형 보문단지를 중심에 둘지 먼저 정하고 나머지 권역은 다른 날 또는 차량 이동 일정으로 분리하는 편이 훨씬 안정적입니다.</p>

    <h2>권역별 강점과 확인할 점</h2>
    <table>
      <thead>
        <tr><th>권역</th><th>어울리는 일정</th><th>강점</th><th>확인할 점</th></tr>
      </thead>
      <tbody>
        {areaRows.map(([area, fit, strength, caution]) => (
          <tr><td><strong>{area}</strong></td><td>{fit}</td><td>{strength}</td><td>{caution}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>구간별 실제 도보 시간</h2>
    <p>숙소를 정하기 전에 아래 구간 시간을 한 번 훑어보면 하루에 넣을 수 있는 코스가 분명해집니다. 표의 시간은 쉬지 않고 걸었을 때 기준이며, 사진을 찍거나 카페에 들르면 실제 소요 시간은 1.5배 이상으로 늘어납니다.</p>
    <table>
      <thead>
        <tr><th>구간</th><th>예상 시간</th><th>메모</th></tr>
      </thead>
      <tbody>
        {walkRows.map(([section, time, memo]) => (
          <tr><td><strong>{section}</strong></td><td>{time}</td><td>{memo}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>황리단길 주변 숙소가 맞는 경우</h2>
    <p>카페, 식사, 산책을 한 권역 안에서 해결하고 싶다면 황리단길 주변이 편합니다. 대릉원과 첨성대 접근도 좋아 첫 방문자에게 무난하고, 낮 일정과 저녁 산책을 같은 권역에서 이어가기 쉽습니다. 다만 주말에는 차량 진입과 주차가 복잡할 수 있어 숙소 전용 주차 여부를 예약 전에 확인해야 합니다. 골목 안쪽 숙소는 캐리어를 끌고 들어가는 길이 평탄한지도 함께 보는 편이 좋습니다.</p>

    <h2>보문단지와 불국사 권역을 고를 때</h2>
    <p>보문단지는 호수 산책로와 대형 숙소가 모여 있어 휴식이 목적인 일정에 잘 맞습니다. 부모님과 함께라면 하루 종일 걷는 시내 코스보다 이쪽이 부담이 적고, 숙소 안에서 쉬는 시간을 넉넉히 둘 수 있습니다. 대신 시내 유적을 보려면 매번 차량이나 버스 이동이 필요하다는 점을 일정에 반영해야 합니다.</p>
    <p>불국사와 석굴암을 제대로 보고 싶다면 오전 일정으로 따로 떼는 편이 좋습니다. 관람 구간에 계단과 경사가 있어 다른 도보 코스와 같은 날에 넣으면 오후 체력이 남지 않습니다. 대중교통으로 이동한다면 버스 배차 간격을 미리 확인하고, 돌아오는 시간까지 계획에 넣어야 합니다.</p>

    <h2>경주역과 터미널 접근성을 보는 경우</h2>
    <p>대중교통으로 이동하거나 짐이 많다면 도착지와 숙소 사이 이동 시간을 먼저 봅니다. KTX 경주역(옛 신경주역)은 시내 중심과 거리가 있어 버스나 택시 이동이 한 번 필요하고, 시외·고속버스 터미널은 시내 권역에 가깝습니다. 도착 시각이 늦다면 첫날은 터미널이나 역 주변에서 묵고 다음 날 아침에 시내 권역으로 옮기는 방법도 있습니다. 짐을 한 번 더 옮기는 대신 도착 직후의 이동 피로를 줄일 수 있습니다.</p>

    <h2>야간 산책은 복귀 길을 기준으로 정합니다</h2>
    <p>첨성대, 월정교, 동궁과 월지는 밤에 만족도가 높지만 늦은 시간에는 이동 선택지가 줄어듭니다. 부모님이나 아이와 함께라면 야간 명소를 하나로 줄이고 숙소까지 돌아오는 길을 먼저 확인하는 편이 좋습니다. 야간 개방 시간은 계절과 시설에 따라 달라지므로 당일 공식 안내를 확인하고, 마지막 코스는 숙소에서 걸어서 돌아올 수 있는 곳으로 두면 가장 안전합니다.</p>

    <h2>동행 유형별 하루 도보량 기준</h2>
    <table>
      <thead>
        <tr><th>동행</th><th>무난한 하루 도보량</th><th>조정 방법</th></tr>
      </thead>
      <tbody>
        {companionRows.map(([who, amount, how]) => (
          <tr><td><strong>{who}</strong></td><td>{amount}</td><td>{how}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>계절별로 달라지는 조건</h2>
    <table>
      <thead>
        <tr><th>계절</th><th>특징</th><th>대응</th></tr>
      </thead>
      <tbody>
        {seasonRows.map(([season, feature, plan]) => (
          <tr><td><strong>{season}</strong></td><td>{feature}</td><td>{plan}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>도보 중심 1일 코스 예시</h2>
    <ol>
      <li><strong>오전</strong> 대릉원과 첨성대를 이어서 걷습니다. 개장 직후가 사람이 가장 적습니다.</li>
      <li><strong>점심</strong> 황리단길 권역에서 식사하고 대기 시간이 길면 대체 식당으로 바꿉니다.</li>
      <li><strong>오후</strong> 숙소에 들러 한 시간 쉬고 국립경주박물관이나 카페 중 하나만 넣습니다.</li>
      <li><strong>저녁</strong> 동궁과 월지, 월정교 중 한 곳만 야간 코스로 남기고 숙소로 걸어서 복귀합니다.</li>
    </ol>

    <section class="checklist-box">
      <h2>예약 전 체크리스트</h2>
      <ul>
        <li>숙소에서 대릉원·첨성대까지 실제 도보 시간 확인하기</li>
        <li>주차 가능 여부와 주말 만차 가능성 확인하기</li>
        <li>야간 산책 후 숙소로 걸어서 복귀할 수 있는지 확인하기</li>
        <li>보문단지 또는 불국사 일정과의 이동 시간 계산하기</li>
        <li>동행 유형에 맞는 하루 도보량을 정하고 코스 수 줄이기</li>
        <li>여름·겨울이라면 그늘과 실내 휴식 지점 확인하기</li>
      </ul>
    </section>

    <section>
      <h2>자주 묻는 질문</h2>
      <div class="faq-list">
        <details>
          <summary>경주 1박 2일에 불국사와 시내 유적을 모두 볼 수 있나요?</summary>
          <p>가능하지만 같은 날에 넣지 않는 편이 좋습니다. 첫날 시내 도보 코스, 다음 날 오전 불국사처럼 나누면 이동과 체력 부담이 줄어듭니다.</p>
        </details>
        <details>
          <summary>차 없이 경주 여행이 가능한가요?</summary>
          <p>시내 권역은 도보와 택시로 충분히 가능합니다. 불국사와 보문단지는 버스 배차 간격을 미리 확인하고, 돌아오는 시간까지 일정에 넣어야 합니다.</p>
        </details>
        <details>
          <summary>부모님과 함께라면 어느 권역이 좋나요?</summary>
          <p>숙소에서 쉬는 시간을 확보하기 좋은 보문단지, 또는 이동 거리가 짧은 황리단길 권역을 먼저 비교하세요. 유적 사이 이동을 택시로 끊어 주면 도보 부담이 크게 줄어듭니다.</p>
        </details>
        <details>
          <summary>벚꽃 시기에는 무엇을 더 준비해야 하나요?</summary>
          <p>보문호 주변과 시내 도로 혼잡, 주차장 진입 대기를 감안해야 합니다. 아침 일찍 움직이거나 숙소에 주차하고 대중교통·도보로 이동하는 편이 안정적입니다.</p>
        </details>
      </div>
    </section>

    <section class="source-note">
      <h2>최종 확인 기준</h2>
