---
import SourceBadge from '../../../components/SourceBadge.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTourApiImage } from '../../../data/tourApiImages.js';

const heroImage = getTourApiImage('seoul', {
  src: '/images/domestic-places/seoul-gyeongbokgung-hyangwonjeong-hero.jpg',
  alt: '서울 경복궁 향원정과 연못 풍경',
  caption: '서울 여행은 궁궐, 전시, 쇼핑, 공연 목적에 따라 숙소 권역과 대중교통 동선이 달라집니다. 사진: Basile Morin, Wikimedia Commons, CC BY-SA 4.0'
});

const areaRows = [
  ['종로·광화문·안국', '궁궐, 박물관, 한옥 골목', '도보와 지하철을 섞기 쉽고 비가 와도 실내 전시로 바꾸기 좋습니다.', '주말 인기 식당 대기가 길어 숙소 주변 식사 후보를 따로 준비합니다.'],
  ['명동·을지로·서울역', '쇼핑, 공항 이동, 첫날·마지막 날', '공항철도와 KTX 접근이 좋아 도착일과 출발일에 유리합니다.', '저녁 시간대 거리 혼잡이 있어 짐이 많으면 이동이 번거롭습니다.'],
  ['홍대·합정·연남', '공연, 야간 일정, 카페', '늦게까지 문을 여는 가게가 많아 밤 일정을 넣기 좋습니다.', '주말 밤 소음과 숙소 주변 혼잡을 감안해야 합니다.'],
  ['성수·건대', '카페, 편집숍, 전시', '한 권역 안에서 걸어 다니며 하루를 채울 수 있습니다.', '관광 명소 밀도는 낮아 다른 권역 이동이 한 번은 필요합니다.'],
  ['강남·삼성·잠실', '전시장, 대형 공연, 쇼핑몰', '실내 대형 시설이 많아 날씨 영향을 적게 받습니다.', '권역이 넓어 도보 이동 거리를 실제로 재보고 숙소를 정해야 합니다.'],
  ['여의도·용산', '한강, 박물관, 가족 일정', '공원과 실내 전시를 함께 묶기 좋고 이동 동선이 단순합니다.', '식사 선택지가 시간대에 따라 몰리므로 예약을 권합니다.']
];

const purposeRows = [
  ['궁궐·역사 답사', '종로, 광화문, 안국', '도보 이동 비중이 높아 숙소에서 첫 목적지까지 거리가 그대로 체력이 됩니다.'],
  ['전시·공연 관람', '공연장 인접 권역 또는 환승 1회 이내', '종료 시각이 늦으므로 복귀 경로를 예매와 동시에 정합니다.'],
  ['쇼핑·맛집 탐방', '명동, 홍대, 성수, 강남 중 한 곳', '짐을 두고 다시 나올 수 있는 위치가 핵심입니다.'],
  ['아이 동반 가족', '용산, 여의도, 잠실', '숙소 복귀가 쉬운 곳이 관광지 개수보다 중요합니다.'],
  ['부모님 동반', '지하철 환승이 적고 엘리베이터가 있는 역 주변', '계단 환승 한 번이 하루 피로를 크게 늘립니다.'],
  ['출장 겸 여행', '서울역, 강남, 여의도', '업무 장소 기준으로 잡고 저녁 일정만 별도 권역으로 둡니다.']
];

const returnRows = [
  ['공연·전시 종료', '보통 21~22시', '종료 후 인파가 한 번에 몰립니다.'],
  ['역까지 도보', '10~15분', '대형 공연장은 출구까지 나오는 시간도 포함해야 합니다.'],
  ['지하철 이동과 환승', '20~40분', '환승 1회당 5~10분을 더합니다.'],
  ['막차 여유', '30분 이상', '노선별 막차는 대체로 자정 전후이며 방향에 따라 다릅니다.']
];

const breadcrumbItems = [
  { name: '국내여행', href: '/domestic/' },
  { name: '서울 여행 목적별 숙소 권역 선택 가이드', href: '/domestic/seoul/purpose-area-hotel-guide/' }
];
---
<BaseLayout title="서울 여행 목적별 숙소 권역 선택 가이드 - Tourpick360" description="서울 여행에서 전시, 공연, 쇼핑, 가족 일정 목적에 맞춰 숙소 권역과 대중교통 동선, 야간 복귀 경로를 정하는 기준을 정리합니다.">
  <article class="article-page longform">
    <Breadcrumb items={breadcrumbItems} />
    <p class="eyebrow">서울 목적별 여행</p>
    <h1>서울 여행 목적별 숙소 권역 선택 가이드</h1>
    <SourceBadge />
    <p class="lead">서울은 어디든 갈 수 있는 도시처럼 보이지만 목적에 따라 좋은 숙소 권역이 크게 달라집니다. 지도에서는 가까워 보여도 환승 한 번, 계단 한 층, 늦은 밤 막차 시간이 실제 일정을 바꿉니다. 전시, 공연, 쇼핑, 가족 일정 중 무엇이 중심인지 먼저 정하고 그 목적에 맞는 권역을 고르면 하루에 쓰는 이동 시간이 눈에 띄게 줄어듭니다.</p>

    <figure class="article-hero-image">
      <img src={heroImage.src} alt={heroImage.alt} width="960" height="540" loading="eager" />
      <figcaption>{heroImage.caption}</figcaption>
    </figure>

    <h2>핵심 요약</h2>
    <table>
      <tbody>
        <tr><th>추천 대상</th><td>서울 1박 2일~2박 3일 여행자, 목적이 뚜렷한 주말 여행, 아이나 부모님과 함께하는 가족 일정</td></tr>
        <tr><th>판단 순서</th><td>여행 목적 하나 정하기 → 목적지 권역 확인 → 환승 횟수 계산 → 야간 복귀 경로 확인 → 숙소 예약</td></tr>
        <tr><th>예산 기준</th><td>숙소 요금 차이보다 하루에 쓰는 교통 시간과 택시비가 총비용을 더 크게 바꿉니다.</td></tr>
        <tr><th>주의사항</th><td>전시·공연 일정, 지하철 막차, 숙소 요금과 주차 조건은 날짜마다 달라지므로 예약 전 다시 확인해야 합니다.</td></tr>
      </tbody>
    </table>

    <h2>서울에서는 목적을 하나로 좁히는 것이 먼저입니다</h2>
    <p>서울 여행 계획이 어려운 이유는 볼거리가 부족해서가 아니라 너무 많기 때문입니다. 궁궐도 보고 쇼핑도 하고 야경도 보고 전시도 넣으면 하루 동선이 도시 전체를 가로지르게 됩니다. 권역과 권역 사이 이동은 대체로 30분에서 1시간이 걸리고, 환승이 끼면 체감 시간은 더 늘어납니다. 하루에 두 권역까지가 무리 없는 상한이라고 보고, 그중 한 곳을 숙소 권역으로 두면 계획이 단순해집니다.</p>
    <p>목적을 하나로 정하라는 말은 다른 것을 포기하라는 뜻이 아닙니다. <strong>어느 일정이 시간을 정확히 지켜야 하는지</strong>를 정하라는 의미입니다. 공연 예매 시간, 전시 마감 시간, 아이의 낮잠 시간처럼 움직일 수 없는 일정이 하나 정해지면 숙소 권역은 거의 자동으로 좁혀집니다.</p>

    <h2>권역별 강점과 확인할 점</h2>
    <table>
      <thead>
        <tr><th>권역</th><th>어울리는 목적</th><th>강점</th><th>확인할 점</th></tr>
      </thead>
      <tbody>
        {areaRows.map(([area, purpose, strength, caution]) => (
          <tr><td><strong>{area}</strong></td><td>{purpose}</td><td>{strength}</td><td>{caution}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>목적별 권역 매칭표</h2>
    <table>
      <thead>
        <tr><th>여행 목적</th><th>우선 검토 권역</th><th>판단 기준</th></tr>
      </thead>
      <tbody>
        {purposeRows.map(([purpose, area, basis]) => (
          <tr><td><strong>{purpose}</strong></td><td>{area}</td><td>{basis}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>전시와 공연 중심 일정</h2>
    <p>전시나 공연은 종료 시간이 늦어질 수 있어 숙소 복귀 동선이 중요합니다. 공연장과 가까운 권역을 고르거나 지하철 환승이 단순한 곳을 선택하면 밤 이동 부담이 줄어듭니다. 특히 대형 공연은 끝나는 순간 수천 명이 같은 역으로 향하기 때문에, 지도상 도보 10분이라도 실제로는 20분이 걸린다고 보는 편이 안전합니다.</p>
    <p>예매를 마쳤다면 그 자리에서 복귀 경로를 함께 정해 두세요. 아래처럼 종료 시각부터 역산하면 숙소를 어디까지 잡아도 되는지가 분명해집니다.</p>
    <table>
      <thead>
        <tr><th>단계</th><th>필요한 시간</th><th>메모</th></tr>
      </thead>
      <tbody>
        {returnRows.map(([step, time, memo]) => (
          <tr><td><strong>{step}</strong></td><td>{time}</td><td>{memo}</td></tr>
        ))}
      </tbody>
    </table>
    <p>계산 결과가 막차와 아슬아슬하다면 숙소를 공연장 권역 안으로 옮기거나, 택시비를 예산에 미리 넣어 두는 편이 낫습니다. 심야 시간대에는 노선이 제한된 심야 버스도 대안이 되지만 배차 간격이 길어 대기 시간을 감수해야 합니다.</p>

    <h2>쇼핑과 맛집 중심 일정</h2>
    <p>쇼핑 목적이라면 짐을 숙소에 두고 다시 나올 수 있는 동선이 편합니다. 명동, 홍대, 성수, 강남처럼 목적 권역이 서로 멀기 때문에 하루에 여러 권역을 넣기보다 한두 곳으로 줄이는 편이 좋습니다. 오전에 한 권역을 돌고 숙소에 들러 짐을 내려놓은 뒤 저녁 일정을 이어가는 방식이 가장 부담이 적습니다.</p>
    <p>맛집 중심 일정이라면 식당 위치보다 <strong>대기 시간</strong>을 먼저 봐야 합니다. 인기 식당은 주말 점심과 저녁에 대기가 길고, 그 시간 동안 근처에서 시간을 보낼 곳이 있는지가 만족도를 좌우합니다. 대기가 20분을 넘으면 옮기겠다는 기준을 미리 정하고 대체 식당 후보를 두 곳씩 적어두면 일정이 밀리지 않습니다.</p>

    <h2>가족 여행은 이동 횟수를 줄입니다</h2>
    <p>아이와 함께라면 관광지 수보다 숙소 주변 식사, 편의점, 대중교통 접근성이 중요합니다. 비가 오거나 아이가 지쳤을 때 20분 안에 숙소로 돌아올 수 있는 위치인지 확인하면 일정이 안정적입니다. 유모차를 쓴다면 역의 엘리베이터 유무가 도보 거리보다 중요한 조건이 됩니다.</p>
    <p>부모님과 함께라면 계단 환승이 가장 큰 변수입니다. 환승 두 번짜리 경로와 환승 없는 버스 경로가 있다면 시간이 조금 더 걸려도 후자가 나은 경우가 많습니다. 하루 도보 거리를 미리 정해 두고 그 안에서 코스를 짜는 방식이 실패가 적습니다.</p>

    <h2>도착·출발 시간이 권역을 결정하는 경우</h2>
    <p>목적보다 시간이 먼저인 일정도 있습니다. 늦은 밤 항공편으로 도착하거나 이른 아침 KTX로 떠난다면 숙소는 취향이 아니라 접근성으로 정해야 합니다. 공항철도와 KTX가 만나는 서울역 주변, 공항버스 정류장이 가까운 권역이 이때 유리합니다. 첫날과 마지막 날만 이런 권역에 묵고 가운데 날에만 목적 권역으로 옮기는 <strong>분할 숙박</strong>도 서울에서는 현실적인 선택지입니다. 짐을 한 번 더 옮기는 대신 이동 시간을 크게 줄일 수 있습니다.</p>

    <h2>하루 일정 예시: 목적이 전시일 때</h2>
    <ol>
      <li><strong>오전</strong> 숙소 권역 안에서 아침을 해결하고 도보 코스 하나만 넣습니다.</li>
      <li><strong>점심</strong> 전시장 근처로 이동해 식사하고 입장 시간에 여유를 둡니다.</li>
      <li><strong>오후</strong> 전시 관람에 집중하고 다른 권역 이동은 넣지 않습니다.</li>
      <li><strong>저녁</strong> 숙소로 돌아와 짐을 정리한 뒤 주변에서 식사와 산책만 남깁니다.</li>
    </ol>

    <section class="checklist-box">
      <h2>예약 전 체크리스트</h2>
      <ul>
        <li>주요 목적지까지 환승 횟수와 실제 소요 시간 확인하기</li>
        <li>야간 일정 종료 시각에서 역산한 복귀 경로 적어두기</li>
        <li>숙소 주변 식사와 편의시설, 24시간 이용 가능한 곳 확인하기</li>
        <li>비 오는 날 대체 가능한 실내 코스 하나 준비하기</li>
        <li>유모차나 부모님 동반이라면 역 엘리베이터 유무 확인하기</li>
        <li>도착일과 출발일에 짐을 맡길 수 있는지 확인하기</li>
      </ul>
    </section>

    <section>
      <h2>자주 묻는 질문</h2>
      <div class="faq-list">
        <details>
          <summary>서울 1박 2일이면 권역을 몇 곳까지 넣을 수 있나요?</summary>
          <p>숙소 권역을 포함해 두 곳이 무난합니다. 세 곳을 넣으면 이동에만 두 시간 이상이 들어가 식사와 휴식 시간이 밀립니다.</p>
        </details>
        <details>
          <summary>숙소 요금이 싼 외곽과 비싼 도심 중 어디가 나은가요?</summary>
          <p>하루 왕복 이동 시간과 택시비를 요금 차이와 함께 비교하세요. 야간 일정이 있으면 도심 쪽이, 낮 일정만 있고 이동이 단순하면 외곽 쪽이 유리할 수 있습니다.</p>
        </details>
        <details>
          <summary>가족 여행에 가장 무난한 권역은 어디인가요?</summary>
          <p>실내 전시와 공원을 함께 묶을 수 있고 숙소 복귀가 쉬운 용산, 여의도, 잠실 권역을 먼저 비교해 보는 것을 권합니다.</p>
        </details>
        <details>
          <summary>서울 여행에 차를 가져가는 게 좋을까요?</summary>
          <p>도심 권역은 주차 요금과 진입 혼잡 때문에 대중교통이 대체로 빠릅니다. 짐이 많거나 이동 인원이 많다면 숙소 주차만 확보하고 관광은 대중교통으로 나누는 방식을 검토하세요.</p>
        </details>
      </div>
    </section>

    <section class="source-note">
      <h2>최종 확인 기준</h2>
