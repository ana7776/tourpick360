---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FestivalArticle from '../../../components/FestivalArticle.astro';
import { festivalApprovalArticles, allFestivalArticles } from '../../../data/festivalApprovalArticles.js';
import { buildSearchDescription, buildSearchTitle } from '../../../utils/searchSnippets.js';

export function getStaticPaths() {
  return festivalApprovalArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const related = allFestivalArticles.filter((item) => item.title !== article.title).slice(0, 4);
const seoTitle = buildSearchTitle(article, '코스·숙소·비용');
const seoDescription = buildSearchDescription(article);
const seoImage = article.ogImage ?? article.heroImage?.src;
---
<BaseLayout title={seoTitle} description={seoDescription} image={seoImage}>
  <FestivalArticle article={article} related={related} />
</BaseLayout>
