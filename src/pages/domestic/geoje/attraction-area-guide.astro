---
import SourceBadge from '../../../components/SourceBadge.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTourApiImage } from '../../../data/tourApiImages.js';

const heroImage = getTourApiImage('geoje_wind_hill', {
  src: '/images/tourapi/geoje-wind-hill.jpg',
  alt: '거제 바람의언덕과 남해 바다 전망',
  caption: '거제는 남부 해안, 섬 정원, 북부 사진 명소, 가족 실내 코스를 권역별로 나눠야 일정이 편해집니다.'
});

const placeGroups = [
  {
    theme: '첫 거제 여행',
    title: '남부 해안권',
    places: ['바람의언덕', '신선대', '해금강', '여차-홍포해안도로', '명사해수욕장'],
    fit: '거제다운 바다 전망을 짧은 시간에 보고 싶은 여행',
    route: '바람의언덕과 신선대는 가까워 함께 보기 좋고, 해금강 유람선이나 여차-홍포해안도로는 날씨와 체력에 따라 붙입니다.',
    caution: '남부권은 전망 만족도가 높지만 바람, 햇빛, 주차 대기 영향을 받기 쉬워 한낮보다 오전이나 오후 후반이 편합니다.'
  },
  {
    theme: '섬과 정원',
    title: '외도 보타니아·해금강 유람선권',
    places: ['외도 보타니아', '해금강 유람선', '내도', '지심도'],
    fit: '배를 타고 섬 정원과 바다 절경을 함께 보고 싶은 여행',
    route: '유람선 선착장, 출항 시간, 기상 취소 가능성을 먼저 확인한 뒤 남부 해안권 일정 앞뒤에 연결합니다.',
    caution: '섬 일정은 배 시간이 전체 일정을 좌우하므로 당일치기라면 섬 하나만 중심으로 잡는 편이 안정적입니다.'
  },
  {
    theme: '사진 명소',
    title: '북부 장목·매미성권',
    places: ['매미성', '장목 해안', '옥포대첩기념공원', '옥포수변공원'],
    fit: '사진, 카페, 짧은 해안 드라이브를 원하는 커플·친구 여행',
    route: '매미성은 북부권에 있어 남부 바람의언덕과 하루에 모두 넣기보다 거가대교 진입·귀가 방향에 맞춰 배치합니다.',
    caution: '주말에는 매미성 주변 도로와 주차가 복잡할 수 있어 점심 전후 피크 시간대를 피하는 것이 좋습니다.'
  },
  {
    theme: '가족·우천 대체',
    title: '실내 체험권',
    places: ['거제식물원 정글돔', '거제씨월드', '버드앤피쉬체험장', '거제조선해양문화관'],
    fit: '아이 동반, 비 예보, 바람이 강한 날의 안정적인 일정',
    route: '오전에는 실내 체험을 먼저 보고, 날씨가 풀리면 오후에 바람의언덕이나 매미성 중 가까운 권역 하나만 붙입니다.',
    caution: '실내 코스도 이동 거리가 있으므로 남부권과 북부권을 무리하게 섞지 말고 숙소 위치 기준으로 고릅니다.'
  },
  {
    theme: '전망과 이동',
    title: '케이블카·노자산권',
    places: ['거제 파노라마 케이블카', '노자산 전망', '학동 흑진주 몽돌해변'],
    fit: '걷는 부담은 줄이고 높은 전망을 보고 싶은 여행',
    route: '케이블카를 중심에 두면 학동 몽돌해변, 바람의언덕, 신선대 중 가까운 해안 코스를 연결하기 쉽습니다.',
    caution: '운행 여부와 바람 영향을 확인하고, 전망이 흐린 날에는 거제식물원 같은 대체 코스를 준비합니다.'
  }
];

const decisionRows = [
  ['거제를 처음 간다', '남부 해안권', '바람의언덕, 신선대, 해금강, 여차-홍포해안도로가 거제 바다 이미지를 가장 빠르게 보여줍니다.'],
  ['섬 정원을 보고 싶다', '외도 보타니아·해금강 유람선권', '배편 시간이 핵심이므로 유람선 일정을 먼저 고정하고 나머지를 줄입니다.'],
  ['사진 명소와 카페가 좋다', '북부 장목·매미성권', '거가대교 방향 이동과 맞추면 왕복 이동 손실이 줄어듭니다.'],
  ['아이와 함께 간다', '실내 체험권', '거제식물원, 씨월드, 체험장이 날씨 변수에 강하고 체류 시간이 예측 가능합니다.'],
  ['모래보다 걷기 편한 해변을 찾는다', '학동 몽돌해변·구조라해수욕장', '몽돌 해변과 모래 해변의 성격이 달라 산책, 물놀이, 사진 목적에 맞춰 고르기 좋습니다.'],
  ['역사·학습을 섞고 싶다', '포로수용소·해금강테마박물관권', '자연 전망 위주의 거제 일정에 역사와 전시 관람을 더하면 가족·부모님 여행의 밀도가 올라갑니다.'],
  ['당일치기다', '남부권 또는 북부권 중 하나', '거제는 섬이 크기 때문에 하루에 남부, 북부, 섬 유람선을 모두 넣으면 피로가 커집니다.'],
  ['봄꽃·계절감을 원한다', '공곶이·내도·수국 코스', '수선화, 동백, 수국처럼 계절 명소는 개화 상태를 확인하고 이동 동선을 짧게 잡습니다.']
];

const officialAdditions = [
  {
    title: '학동 흑진주 몽돌해변',
    type: '해변 산책·사진',
    point: '모래 대신 몽돌이 이어지는 해변이라 물에 젖은 돌의 질감과 파도 소리가 인상적입니다.',
    howToUse: '케이블카·노자산권이나 남부 해안권 사이에 짧은 산책 코스로 넣기 좋습니다.'
  },
  {
    title: '구조라해수욕장·지세포항',
    type: '숙소·식사 거점',
    point: '외도 유람선, 해수욕장, 항구 주변 편의시설을 함께 고려할 수 있는 거점 후보입니다.',
    howToUse: '섬 유람선 일정이 있는 날에는 승선지와 숙소 위치를 먼저 맞춘 뒤 주변 식사를 배치합니다.'
  },
  {
    title: '거제대교·해안 진입 동선',
    type: '드라이브 판단',
    point: '거제는 통영 방향과 거가대교 방향 진입에 따라 첫 코스가 달라지는 섬 여행지입니다.',
    howToUse: '통영 쪽에서 들어오면 남부권, 부산·창원 쪽에서 들어오면 매미성·장목권을 먼저 보는 식으로 잡습니다.'
  },
  {
    title: '거제도 포로수용소 유적공원',
    type: '역사·학습',
    point: '한국전쟁 시기 거제의 역사를 이해할 수 있어 자연 관광만으로 아쉬운 가족 여행에 잘 맞습니다.',
    howToUse: '비 예보가 있거나 아이와 역사 학습을 겸할 때 실내·전시형 대체 코스로 검토합니다.'
  },
  {
    title: '해금강테마박물관',
    type: '전시·휴식',
    point: '해금강과 바람의언덕 일대에서 바람이 강하거나 걷기 피로가 쌓였을 때 쉬어가기 좋은 전시 후보입니다.',
    howToUse: '바람의언덕, 신선대, 해금강 유람선 중간에 넣으면 야외 전망 일정의 밀도를 조절할 수 있습니다.'
  },
  {
    title: '반곡서원·옥포대첩기념공원',
    type: '조용한 역사 산책',
    point: '거제의 바다 명소와 다른 결의 역사 공간이라 부모님 동반이나 혼잡을 피하고 싶은 일정에 어울립니다.',
    howToUse: '북부권이나 시내권 이동 중 짧게 붙이고, 남부 해안권과 한 번에 모두 묶지는 않습니다.'
  }
];

const routeExamples = [
  ['거제 첫 방문 1일', '바람의언덕 - 신선대 - 해금강 전망 또는 유람선 - 여차-홍포해안도로 순서로 남부권을 중심에 둡니다.'],
  ['가족 우천 코스', '거제식물원 정글돔 - 거제씨월드 또는 조선해양문화관 - 비가 그치면 가까운 해안 전망지 하나를 붙입니다.'],
  ['사진 여행 코스', '매미성 - 장목 해안 카페 - 옥포대첩기념공원으로 북부권을 보고, 숙소가 남부라면 다음 날 바람의언덕을 봅니다.'],
  ['섬 정원 코스', '외도 보타니아 유람선 시간을 먼저 예약하고, 승선 전후로 해금강·바람의언덕 중 하나만 연결합니다.'],
  ['역사와 전시 코스', '포로수용소 유적공원 - 해금강테마박물관 - 바람의언덕 또는 학동 몽돌해변으로 자연과 학습을 섞습니다.'],
  ['봄·초여름 계절 코스', '공곶이 수선화, 내도, 남부 수국, 학동 몽돌해변 중 계절에 맞는 한 축을 정하고 바다 전망지를 짧게 더합니다.']
];

const sourceLinks = [
  ['마이트래블노트 거제 검색 결과', 'https://www.mytravelnotes.co.kr/search?q=%EA%B1%B0%EC%A0%9C'],
  ['2026 거제 핫플 봄맞이 BEST 6', 'https://www.mytravelnotes.co.kr/geoje-hotspot-spring-guide'],
  ['2026 거제 주말 나들이 봄 여행 코스', 'https://www.mytravelnotes.co.kr/geoje-spring-trip'],
  ['2026 거제 겨울 여행 가이드', 'https://www.mytravelnotes.co.kr/geoje-winter-travel'],
  ['대한민국 구석구석 거제 검색 페이지', 'https://korean.visitkorea.or.kr/search/search_list.do?keyword=%EA%B1%B0%EC%A0%9C'],
  ['대한민국 구석구석 바람의 언덕', 'https://korean.visitkorea.or.kr/detail/ms_detail.do?cotid=90c5cf0c-ff79-4b64-a3b9-afa02a465e46'],
  ['대한민국 구석구석 해금강 누리기 여행기사', 'https://korean.visitkorea.or.kr/detail/rem_detail.do?cotid=fc943744-2378-4012-99db-769bb4d88ad3'],
  ['대한민국 구석구석 거제 역사 여행코스', 'https://korean.visitkorea.or.kr/detail/cs_detail_cos.do?cotid=c2e10238-4998-402d-a69b-bc3dcf4b8841'],
  ['대한민국 구석구석 거제식물원', 'https://korean.visitkorea.or.kr/detail/ms_detail.do?cotid=86fbf2fb-2f60-4ad7-bd70-31edc0cc8cb7'],
  ['대한민국 구석구석 해금강유람선', 'https://korean.visitkorea.or.kr/detail/ms_detail.do?cotid=ea760ab7-d7e2-41ab-9434-ac1ca569d3b2']
