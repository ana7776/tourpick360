---
import { stylesVersion } from '../utils/assetVersion.js';

const {
  title = 'Tourpick360 - 국내 계절 축제 여행 가이드',
  description = 'Tourpick360은 국내 계절 여행과 축제 여행을 중심으로 숙소 위치, 이동 동선, 주차, 이용 시간, 여행 준비 정보를 정리하는 전문 여행 정보 사이트입니다.',
  lang = 'ko',
  image = '/images/domestic-places/busan-haeundae-beach-hero.jpg',
  robots = 'index, follow'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://tourpick360.com').toString();
const ogImageUrl = new URL(image, 'https://tourpick360.com').toString();

const navLabels = ['국내여행', '축제', '제주', '여행준비', '사례', '템플릿', '소개'];

const footerGroups = {
  service: '서비스',
  destinations: '인기 여행지',
  policy: '운영 정보'
};

const serviceLinks = [
  { label: '국내여행 허브', href: '/domestic/' },
  { label: '축제 여행', href: '/domestic/festivals/' },
  { label: '제주 가이드', href: '/domestic/jeju/' },
  { label: '여행 준비', href: '/travel-tips/' },
  { label: '일정 개선 사례', href: '/case-studies/' },
  { label: '여행 준비 템플릿', href: '/templates/' },
  { label: '비교 도구', href: '/tools/itinerary-comparison/' }
];

const destinationLinks = [
  { label: '서울', href: '/domestic/seoul/purpose-area-hotel-guide/' },
  { label: '부산', href: '/domestic/busan/family-hotel-area-guide/' },
  { label: '강릉', href: '/domestic/gangneung/ktx-weekend-trip-guide/' },
  { label: '경주', href: '/domestic/gyeongju/walking-route-hotel-area-guide/' },
  { label: '여수', href: '/domestic/yeosu/night-view-hotel-route-guide/' }
];

const policyLinks = [
  { label: '소개', href: '/about/' },
  { label: '편집 기준', href: '/editorial-policy/' },
  { label: '문의', href: '/contact/' },
  { label: '개인정보처리방침', href: '/privacy/' },
  { label: '이용약관', href: '/terms/' },
  { label: '정보 제공 원칙', href: '/disclosure/' }
];

const footerText = '국내 계절 여행과 축제 여행을 중심으로 숙소 위치, 이동 동선, 준비 정보를 정리하는 여행 정보 사이트입니다.';
const footerMenuLabel = lang === 'ko' ? '푸터 메뉴' : 'Footer menu';
const mainMenuLabel = lang === 'ko' ? '주요 메뉴' : 'Main menu';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={`${robots}, max-snippet:-1, max-image-preview:large, max-video-preview:-1`} />
    <meta name="naver-site-verification" content="0c61f2bbe652e60a3afb42af50833fc3f04eeb27" />
    <meta name="google-adsense-account" content="ca-pub-5804969457082424" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Tourpick360 RSS" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tourpick360" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="stylesheet" href={`/styles.css?v=${stylesVersion}`} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5804969457082424" crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Tourpick360 홈">
        <span class="brand-mark">360</span>
        <span>Tourpick360</span>
      </a>
      <nav class="main-nav" aria-label={mainMenuLabel}>
        <a href="/domestic/">{navLabels[0]}</a>
        <a href="/domestic/festivals/">{navLabels[1]}</a>
        <a href="/domestic/jeju/">{navLabels[2]}</a>
        <a href="/travel-tips/">{navLabels[3]}</a>
        <a href="/case-studies/">{navLabels[4]}</a>
        <a href="/templates/">{navLabels[5]}</a>
        <a href="/about/">{navLabels[6]}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>Tourpick360</strong>
        <p>{footerText}</p>
        <p class="footer-author">작성자 및 관리자: 김안나 · <a href="mailto:anagim7776@gmail.com">anagim7776@gmail.com</a></p>
        <p class="footer-disclaimer">본 사이트의 정보는 참고용이며, 실제 이용 전 반드시 공식 홈페이지를 확인하십시오.</p>
      </div>
      <nav class="footer-link-group" aria-label={footerMenuLabel}>
        <strong>{footerGroups.service}</strong>
        {serviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <nav class="footer-link-group" aria-label={footerGroups.destinations}>
        <strong>{footerGroups.destinations}</strong>
        {destinationLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <nav class="footer-link-group" aria-label={footerGroups.policy}>
        <strong>{footerGroups.policy}</strong>
        {policyLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/sitemap-index.xml">Sitemap</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </footer>
  </body>
</html>
